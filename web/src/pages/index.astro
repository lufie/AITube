---
import "../styles/global.css";
import LogoMark from "../components/LogoMark.astro";
import { withBase } from "../lib/i18n";
import { absUrl } from "../lib/seo";
import { CONCEPTS, NODES, ERAS } from "../lib/content";

const canonical = absUrl("/");
const ogImage = absUrl("/og/home-zh.png");
const zhHome = withBase("/zh/");
const enHome = withBase("/en/");
---
<!doctype html>
<html lang="zh-CN" data-zh-home={zhHome} data-en-home={enHome}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AITube — 用大白话讲透 AI 概念与精选视频片段</title>
    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const zh = root.getAttribute("data-zh-home") || "/zh/";
          const en = root.getAttribute("data-en-home") || "/en/";
          const saved = localStorage.getItem("aitube-lang");
          const target = saved === "en" ? en : zh;
          window.location.replace(target);
        } catch {}
      })();
    </script>
    <meta
      name="description"
      content="不堆专业黑话：用一张 2017–2026 时间线和 280 支掐好时间点的精选视频片段，帮小白、应用者和开发者快速抓准 AI 重点。"
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={absUrl("/zh/")} />
    <link rel="alternate" hreflang="en" href={absUrl("/en/")} />
    <link rel="alternate" hreflang="x-default" href={absUrl("/zh/")} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AITube — AI Explained in Plain Language" />
    <meta property="og:description" content="22 Core AI Topics (2017–2026) · 280 Hand-Picked Video Highlights · Zero Jargon." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "AITube",
      url: canonical,
    })} />
  </head>
  <body>
    <main style="display:flex;align-items:center;justify-content:center;min-height:100vh;padding:32px;">
      <div style="max-width:640px;width:100%;border:1px solid var(--border-subtle);background:var(--bg-elevated);border-radius:6px;padding:36px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
          <LogoMark size={36} />
          <span class="at-mono" style="font-size:0.8rem;color:var(--accent-primary);">
            AITube · {ERAS.length} 个阶段 · {CONCEPTS.length} 个核心词 · {NODES.length} 支精华片段
          </span>
        </div>
        <h1 style="font-size:2rem;margin-bottom:12px;">
          AITube · 用大白话讲透 AI 怎么工作、怎么用好
        </h1>
        <p style="color:var(--ink-secondary);margin-bottom:24px;">
          替你从上千小时视频里挑出最值得看的那几分钟，按你的需求直接找重点。Choose your language:
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;">
          <a href={withBase("/zh/")} class="at-btn-primary">进入中文版（简体中文） →</a>
          <a href={withBase("/en/")} class="at-btn-ghost">Enter English Edition →</a>
        </div>
      </div>
    </main>
  </body>
</html>
