---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { LANGS, UI, withBase, type Lang } from "../../../lib/i18n";
import { VAULT_ITEMS, getConcept } from "../../../lib/content";
import { buildBreadcrumbSchema, orgAndSiteGraph } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

const title =
  lang === "zh"
    ? "现成模板箱 — AITube"
    : "Ready-to-Use AI Templates — AITube";
const desc =
  lang === "zh"
    ? "不用注册登录，一键复制即可放进项目使用的实战模板：AGENTS.md 项目规范、SKILL.md 技能说明书、评估提示词与混合检索代码。"
    : "No sign-up required — copy battle-tested AGENTS.md rules, SKILL.md manuals, evaluation prompts, and hybrid search code.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...orgAndSiteGraph(lang),
    buildBreadcrumbSchema([
      { name: "AITube", path: `/${lang}/` },
      { name: t.navVault, path: `/${lang}/vault/` },
    ]),
  ],
};
---
<BaseLayout
  title={title}
  description={desc}
  lang={lang}
  pathname={`/${lang}/vault/`}
  ogImage={`/og/vault-${lang}.png`}
  schema={schema}
>
  <section class="at-page-header">
    <div class="at-container at-page-header-center">
      <h1 class="at-page-h1">{t.navVault}</h1>
      <p class="at-page-lead">{desc}</p>
    </div>
  </section>

  <section class="at-container" style="padding:0 28px 68px;max-width:920px;display:flex;flex-direction:column;gap:24px;">
    {VAULT_ITEMS.map((v, idx) => {
      const loc = v[lang];
      const concept = getConcept(v.conceptSlug);
      return (
        <article
          id={v.id}
          style="border-radius:var(--radius-lg);padding:28px;background:var(--bg-elevated);"
        >
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:8px;">
            <span class="at-kicker">
              0{idx + 1} · {loc.tag}
            </span>
            {concept && (
              <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} class="at-text-link" style="font-size:0.82rem;">
                {concept[lang].shortName} ›
              </a>
            )}
          </div>

          <h2 style="font-size:1.32rem;margin-bottom:8px;">{loc.title}</h2>
          <p style="color:var(--ink-secondary);font-size:0.94rem;line-height:1.6;margin-bottom:18px;">
            {loc.summary}
          </p>

          <div style="position:relative;border-radius:var(--radius-md);background:var(--bg-canvas);padding:18px 20px;">
            <button
              type="button"
              class="at-btn-ghost"
              data-copy-op={loc.previewSnippet}
              style="position:absolute;top:12px;right:12px;padding:5px 12px;font-size:0.76rem;background:var(--bg-elevated);"
            >
              <span>{lang === "zh" ? "复制模板" : "Copy"}</span>
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.75;flex-shrink:0;">
                <rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1.5" />
                <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
              </svg>
            </button>
            <pre class="at-code" style="margin:0;font-size:0.8rem;line-height:1.6;overflow-x:auto;white-space:pre-wrap;padding-right:96px;color:var(--ink-primary);">{loc.previewSnippet}</pre>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
