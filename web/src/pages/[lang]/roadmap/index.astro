---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MediaCard from "../../../components/MediaCard.astro";
import { LANGS, UI, withBase, type Lang } from "../../../lib/i18n";
import { SPINE_NODES, STAGES } from "../../../lib/content";
import { buildBreadcrumbSchema, orgAndSiteGraph } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

const roleTabs =
  lang === "zh"
    ? [
        { role: "beginner", stage: "stage-0", label: "第 0 阶 · 零基础" },
        { role: "applied", stage: "stage-1", label: "第 1 阶 · 日常应用" },
        { role: "career", stage: "stage-2", label: "第 2 阶 · 转行开发" },
        { role: "frontier", stage: "stage-3", label: "第 3 阶 · 上线实战" },
      ]
    : [
        { role: "beginner", stage: "stage-0", label: "Stage 0 · Basics" },
        { role: "applied", stage: "stage-1", label: "Stage 1 · Daily Use" },
        { role: "career", stage: "stage-2", label: "Stage 2 · Build Apps" },
        { role: "frontier", stage: "stage-3", label: "Stage 3 · Production" },
      ];

const stageStarterMap: Record<string, string[]> = {
  "stage-0": [
    "karpathy-three-stage-llm-pipeline",
    "3b1b-transformer-overview",
    "embeddings-vector-geometry-explained",
  ],
  "stage-1": [
    "karpathy-how-i-use-llms-workflows",
    "notebooklm-grounded-research-workflow",
    "comfyui-modular-node-pipeline",
  ],
  "stage-2": [
    "cursor-tool-calling-loop-anatomy",
    "stanford-bm25-to-agentic-rag",
    "anthropic-mcp-workshop-mahesh",
  ],
  "stage-3": [
    "anthropic-context-engineering-digest",
    "dont-build-agents-build-skills",
    "hamel-husain-llm-evals-mistakes",
  ],
};

const title =
  lang === "zh"
    ? `学习路线：4 个阶段循序渐进掌握 AI（${SPINE_NODES.length} 支核心精选）— AITube`
    : `Learning Pathways: 4 Clear Stages (${SPINE_NODES.length} Essential Highlights) — AITube`;
const desc =
  lang === "zh"
    ? "不用一次看完所有内容：先选适合你的起点，每一阶先看最关键的 3 支视频即可。"
    : "Start at the stage that matches your background — watch just the Top 3 highlights per stage first.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...orgAndSiteGraph(lang),
    buildBreadcrumbSchema([
      { name: "AITube", path: `/${lang}/` },
      { name: t.navRoadmap, path: `/${lang}/roadmap/` },
    ]),
  ],
};
---
<BaseLayout
  title={title}
  description={desc}
  lang={lang}
  pathname={`/${lang}/roadmap/`}
  ogImage={`/og/roadmap-${lang}.png`}
  schema={schema}
>
  <section class="at-page-header">
    <div class="at-container">
      <div class="at-page-header-center">
        <h1 class="at-page-h1">{t.roadmapHeading}</h1>
        <p class="at-page-lead">{desc}</p>
      </div>

      <div style="margin-top:26px;display:flex;justify-content:center;">
        <div class="at-segmented" role="group" aria-label="Starting stage">
          {roleTabs.map((g, idx) => (
            <a
              href={`#${g.stage}`}
              class={`at-seg-btn ${idx === 0 ? "is-active" : ""}`}
              data-rm-role={g.role}
              data-rm-target={g.stage}
            >
              {g.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="at-container" style="padding-bottom:68px;">
    {STAGES.map((st, sIdx) => {
      const stageNodes = SPINE_NODES.filter((n) => n.stageId === st.id);
      const prefSlugs = stageStarterMap[st.id] || [];
      const coreNodes = prefSlugs
        .map((s) => stageNodes.find((n) => n.slug === s))
        .filter(Boolean)
        .concat(stageNodes)
        .filter((v, i, a) => v && a.findIndex((x) => x?.slug === v.slug) === i)
        .slice(0, 3) as typeof stageNodes;
      const coreSet = new Set(coreNodes.map((n) => n.slug));
      const extraNodes = stageNodes.filter((n) => !coreSet.has(n.slug));

      return (
        <section
          class="at-section"
          id={st.id}
          data-stage-section={st.id}
          style={sIdx === 0 ? "scroll-margin-top:76px;" : "scroll-margin-top:76px;"}
        >
          <div class="at-section-head">
            <div style="max-width:66ch;">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
                <span class="at-kicker">{st[lang].code}</span>
                <span
                  class="at-life at-life-mainstream"
                  data-rec-badge={st.id}
                  style="display:none;"
                >
                  {lang === "zh" ? "推荐起点" : "Recommended Start"}
                </span>
              </div>
              <h2>{st[lang].title}</h2>
              <p style="color:var(--ink-secondary);margin-top:6px;font-size:0.95rem;">{st[lang].summary}</p>
            </div>
          </div>

          <div class="at-grid-cards">
            {coreNodes.map((n) => (
              <MediaCard node={n} lang={lang} />
            ))}
          </div>

          {extraNodes.length > 0 && (
            <div style="margin-top:26px;">
              <button
                type="button"
                class="at-btn-ghost"
                data-toggle-stage={st.id}
                data-label-closed={
                  lang === "zh"
                    ? `展开本阶其余 ${extraNodes.length} 支进阶视频 ▾`
                    : `Show ${extraNodes.length} more videos in this stage ▾`
                }
                data-label-open={
                  lang === "zh"
                    ? `收起其余 ${extraNodes.length} 支视频 ▴`
                    : `Hide ${extraNodes.length} extra videos ▴`
                }
              >
                {lang === "zh"
                  ? `展开本阶其余 ${extraNodes.length} 支进阶视频 ▾`
                  : `Show ${extraNodes.length} more videos in this stage ▾`}
              </button>

              <div class="at-grid-cards" data-stage-extra={st.id} style="display:none;margin-top:24px;">
                {extraNodes.map((n) => (
                  <MediaCard node={n} lang={lang} />
                ))}
              </div>
            </div>
          )}
        </section>
      );
    })}

    <div style="padding-top:16px;text-align:center;">
      <a href={withBase(`/${lang}/directory/`)} class="at-text-link">
        {lang === "zh" ? "想直接按问题或工具找视频？前往视频库 ›" : "Looking for a specific tool or topic? Browse Video Library ›"}
      </a>
    </div>
  </div>

  <script is:inline>
    (() => {
      document.querySelectorAll("[data-toggle-stage]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-toggle-stage");
          const box = document.querySelector(`[data-stage-extra="${id}"]`);
          if (!box) return;
          const open = box.style.display === "none";
          box.style.display = open ? "" : "none";
          btn.textContent = open
            ? btn.getAttribute("data-label-open")
            : btn.getAttribute("data-label-closed");
        });
      });

      const roleToStage = {
        beginner: "stage-0",
        applied: "stage-1",
        career: "stage-2",
        frontier: "stage-3",
      };

      function highlightRole(role) {
        const stId = roleToStage[role];
        if (!stId) return;
        document.querySelectorAll("[data-rm-role]").forEach((el) => {
          el.classList.toggle("is-active", el.getAttribute("data-rm-role") === role);
        });
        document.querySelectorAll("[data-rec-badge]").forEach((el) => {
          el.style.display = el.getAttribute("data-rec-badge") === stId ? "inline-flex" : "none";
        });
      }

      try {
        const sp = new URLSearchParams(window.location.search);
        const r = sp.get("role") || localStorage.getItem("aitube-role");
        if (r && roleToStage[r]) highlightRole(r);
      } catch {}

      document.querySelectorAll("[data-rm-role]").forEach((el) => {
        el.addEventListener("click", () => {
          const r = el.getAttribute("data-rm-role");
          if (r) {
            highlightRole(r);
            try {
              localStorage.setItem("aitube-role", r);
            } catch {}
          }
        });
      });
    })();
  </script>
</BaseLayout>
