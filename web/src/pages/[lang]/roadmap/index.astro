---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MediaCard from "../../../components/MediaCard.astro";
import { LANGS, UI, withBase, type Lang } from "../../../lib/i18n";
import { SPINE_NODES, STAGES } from "../../../lib/content";
import { buildBreadcrumbSchema, orgAndSiteGraph } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

const roleGuides =
  lang === "zh"
    ? [
        { role: "beginner", stage: "stage-0", icon: "🌱", who: "我是零基础小白", tip: "直接看 Stage 00 的前 3 支先导课，35 分钟建立底层直觉" },
        { role: "applied", stage: "stage-1", icon: "⚡", who: "我想直接应用提效", tip: "跳过底层数学，从 Stage 01（提示契约、知识库与多模态）切入" },
        { role: "career", stage: "stage-2", icon: "🧭", who: "我想转型 AI 工程师", tip: "主攻 Stage 02 + Stage 03：工具循环、混合检索、MCP 与评测" },
        { role: "frontier", stage: "stage-3", icon: "🔭", who: "我有基础追前沿", tip: "直奔 Stage 03：上下文工程、SKILL.md 渐进技能与子智能体隔离" },
      ]
    : [
        { role: "beginner", stage: "stage-0", icon: "🌱", who: "Complete Beginner", tip: "Watch the Top 3 starter cuts in Stage 00 for zero-math visual intuition" },
        { role: "applied", stage: "stage-1", icon: "⚡", who: "Hands-On User", tip: "Start at Stage 01 for prompting contracts, NotebookLM & ComfyUI flows" },
        { role: "career", stage: "stage-2", icon: "🧭", who: "Aspiring AI Engineer", tip: "Focus on Stage 02 + 03: tool loops, hybrid RAG, MCP & LLM Evals" },
        { role: "frontier", stage: "stage-3", icon: "🔭", who: "Experienced Practitioner", tip: "Jump straight to Stage 03: Context Engineering, SKILL.md & Subagents" },
      ];

const stageStarterMap: Record<string, string[]> = {
  "stage-0": [
    "karpathy-three-stage-llm-pipeline",
    "3b1b-transformer-overview",
    "embeddings-vector-geometry-explained",
  ],
  "stage-1": [
    "karpathy-how-i-use-llms-workflows",
    "notebooklm-grounded-research-workflow",
    "comfyui-modular-node-pipeline",
  ],
  "stage-2": [
    "cursor-tool-calling-loop-anatomy",
    "stanford-bm25-to-agentic-rag",
    "anthropic-mcp-workshop-mahesh",
  ],
  "stage-3": [
    "anthropic-context-engineering-digest",
    "dont-build-agents-build-skills",
    "hamel-husain-llm-evals-mistakes",
  ],
};

const stageAudienceLabel: Record<string, { zh: string; en: string }> = {
  "stage-0": { zh: "🌱 适合：零基础小白建立全景直觉", en: "🌱 Best for: Beginners building core intuition" },
  "stage-1": { zh: "⚡ 适合：日常提问、知识库与视觉创作应用", en: "⚡ Best for: Applied workflows & multimodal creation" },
  "stage-2": { zh: "🧭 适合：AI 应用开发、RAG、MCP 与自主编程", en: "🧭 Best for: Full-stack AI builders, RAG & MCP" },
  "stage-3": { zh: "🔭 适合：生产级智能体架构、Skills 与自动化评测", en: "🔭 Best for: Senior engineers, Skills & Evals" },
};

const title =
  lang === "zh"
    ? `对号入座：从零基础到 AI 工程师的四阶路线（${SPINE_NODES.length} 支必修）— AITube`
    : `4-Stage AI Learning Paths (${SPINE_NODES.length} Spine Cuts) — AITube`;
const desc =
  lang === "zh"
    ? "不用从头硬啃 280 支视频：先对号入座找到适合你的起跑阶段，每阶精选 3 支必看先导课，其余按需展开。"
    : "Find your exact starting stage. Watch the Top 3 essential cuts per stage first, then expand deeper practice cuts on demand.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...orgAndSiteGraph(lang),
    buildBreadcrumbSchema([
      { name: "AITube", path: `/${lang}/` },
      { name: t.navRoadmap, path: `/${lang}/roadmap/` },
    ]),
  ],
};
---
<BaseLayout
  title={title}
  description={desc}
  lang={lang}
  pathname={`/${lang}/roadmap/`}
  ogImage={`/og/roadmap-${lang}.png`}
  schema={schema}
>
  <section style="padding:36px 0 26px;border-bottom:1px solid var(--border-subtle);background:linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg-canvas) 100%);">
    <div class="at-container">
      <div class="at-kicker">
        {lang === "zh" ? `STEP-BY-STEP PATHS · 不用一次看完 ${SPINE_NODES.length} 支，每阶先看前 3 支核心课` : `CURATED PATHS · START WITH TOP 3 CUTS PER STAGE`}
      </div>
      <h1 style="font-size:clamp(1.8rem,2.9vw,2.45rem);margin:8px 0 10px;">
        {t.roadmapHeading}
      </h1>
      <p style="max-width:68ch;color:var(--ink-secondary);margin-bottom:20px;">
        {lang === "zh"
          ? "不同背景不用从同一集看起。点选下方你的身份，直接跳到推荐你的起跑阶段；每个阶段默认只展示最关键的 3 支先导课，看完有余力再展开进阶课表。"
          : "Different goals require different starting points. Pick your profile below to jump straight to your recommended stage — each stage highlights its Top 3 essential cuts first."}
      </p>

      <!-- 4-Persona Starting-Point Selector -->
      <div class="at-roadmap-guides">
        {roleGuides.map((g) => (
          <a href={`#${g.stage}`} class="at-roadmap-guide-card" data-rm-role={g.role} data-rm-target={g.stage}>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;">
              <strong style="font-size:0.96rem;color:var(--ink-primary);">
                {g.icon} {g.who}
              </strong>
              <span class="at-mono" style="font-size:0.72rem;color:var(--accent-primary);font-weight:650;">
                {g.stage.toUpperCase().replace("-", " 0")} ↓
              </span>
            </div>
            <p style="font-size:0.8rem;color:var(--ink-secondary);line-height:1.45;">{g.tip}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="at-container" style="padding-bottom:56px;">
    {STAGES.map((st) => {
      const stageNodes = SPINE_NODES.filter((n) => n.stageId === st.id);
      const prefSlugs = stageStarterMap[st.id] || [];
      const coreNodes = prefSlugs
        .map((s) => stageNodes.find((n) => n.slug === s))
        .filter(Boolean)
        .concat(stageNodes)
        .filter((v, i, a) => v && a.findIndex((x) => x?.slug === v.slug) === i)
        .slice(0, 3) as typeof stageNodes;
      const coreSet = new Set(coreNodes.map((n) => n.slug));
      const extraNodes = stageNodes.filter((n) => !coreSet.has(n.slug));
      const audMeta = stageAudienceLabel[st.id];

      return (
        <section class="at-section at-stage-block" id={st.id} data-stage-section={st.id}>
          <div class="at-section-head">
            <div>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
                <span class="at-kicker" style="margin-bottom:0;">
                  {st[lang].code} · {stageNodes.length} {lang === "zh" ? "支必修切片" : "SPINE CUTS"}
                </span>
                {audMeta && (
                  <span class="at-audience-pill">
                    {audMeta[lang]}
                  </span>
                )}
                <span class="at-stage-rec-badge at-mono" data-rec-badge={st.id} style="display:none;">
                  ★ {lang === "zh" ? "推荐你的起跑阶段" : "RECOMMENDED START"}
                </span>
              </div>
              <h2>{st[lang].title}</h2>
              <p style="color:var(--ink-secondary);margin-top:6px;max-width:66ch;">{st[lang].summary}</p>
            </div>
          </div>

          <div class="at-mono" style="font-size:0.75rem;color:var(--accent-signal);font-weight:650;margin-bottom:12px;">
            ★ {lang === "zh" ? "本阶段必看前 3 支核心先导课（先看这 3 支即可掌握主干）" : "START HERE: TOP 3 ESSENTIAL CUTS FOR THIS STAGE"}
          </div>

          <div class="at-grid-cards">
            {coreNodes.map((n) => (
              <MediaCard node={n} lang={lang} />
            ))}
          </div>

          {extraNodes.length > 0 && (
            <div style="margin-top:18px;">
              <button
                type="button"
                class="at-stage-expand-btn at-mono"
                data-toggle-stage={st.id}
                data-label-closed={
                  lang === "zh"
                    ? `+ 展开本阶段其余 ${extraNodes.length} 支进阶实操课 ▾`
                    : `+ Show ${extraNodes.length} more practice cuts in this stage ▾`
                }
                data-label-open={
                  lang === "zh"
                    ? `− 收起其余 ${extraNodes.length} 支进阶课 ▴`
                    : `− Collapse ${extraNodes.length} extra cuts ▴`
                }
              >
                {lang === "zh"
                  ? `+ 展开本阶段其余 ${extraNodes.length} 支进阶实操课 ▾`
                  : `+ Show ${extraNodes.length} more practice cuts in this stage ▾`}
              </button>

              <div class="at-grid-cards" data-stage-extra={st.id} style="display:none;margin-top:16px;">
                {extraNodes.map((n) => (
                  <MediaCard node={n} lang={lang} />
                ))}
              </div>
            </div>
          )}
        </section>
      );
    })}

    <div style="padding-top:12px;text-align:center;">
      <a href={withBase(`/${lang}/directory/`)} class="at-btn-ghost">
        {lang === "zh" ? "想按具体工具或问题自由搜索？进入实战切片库 →" : "Looking for a specific tool or workflow? Open Video Cuts →"}
      </a>
    </div>
  </div>

  <script is:inline>
    (() => {
      document.querySelectorAll("[data-toggle-stage]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-toggle-stage");
          const box = document.querySelector(`[data-stage-extra="${id}"]`);
          if (!box) return;
          const open = box.style.display === "none";
          box.style.display = open ? "" : "none";
          btn.textContent = open
            ? btn.getAttribute("data-label-open")
            : btn.getAttribute("data-label-closed");
        });
      });

      const roleToStage = {
        beginner: "stage-0",
        applied: "stage-1",
        career: "stage-2",
        frontier: "stage-3",
      };

      function highlightRole(role) {
        const stId = roleToStage[role];
        if (!stId) return;
        document.querySelectorAll("[data-rm-role]").forEach((el) => {
          el.classList.toggle("is-active", el.getAttribute("data-rm-role") === role);
        });
        document.querySelectorAll("[data-rec-badge]").forEach((el) => {
          el.style.display = el.getAttribute("data-rec-badge") === stId ? "inline-flex" : "none";
        });
      }

      try {
        const sp = new URLSearchParams(window.location.search);
        const r = sp.get("role") || localStorage.getItem("aitube-role");
        if (r && roleToStage[r]) highlightRole(r);
      } catch {}

      document.querySelectorAll("[data-rm-role]").forEach((el) => {
        el.addEventListener("click", () => {
          const r = el.getAttribute("data-rm-role");
          if (r) {
            highlightRole(r);
            try {
              localStorage.setItem("aitube-role", r);
            } catch {}
          }
        });
      });
    })();
  </script>
</BaseLayout>
