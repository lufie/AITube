---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MediaCard from "../../../components/MediaCard.astro";
import {
  BASE_PREFIX,
  LANGS,
  UI,
  formatDurationBadge,
  type Lang,
} from "../../../lib/i18n";
import { CONCEPTS, ERAS, NODES, TAXONOMY_DIMS, getConcept } from "../../../lib/content";
import { DIRECTORY_SCENARIOS } from "../../../lib/personas";
import { buildBreadcrumbSchema, orgAndSiteGraph } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const basePrefix = BASE_PREFIX;
const t = UI[lang];
const initialNodes = NODES.slice(0, 24);
const doneBadgeText = lang === "zh" ? "已看" : "Watched";
const stripEmoji = (s: string) => s.replace(/^[^\w\u4e00-\u9fff]+\s*/, "");

const clientCatalog = NODES.map((n) => {
  const c = getConcept(n.primaryConcept);
  const s = n.source;
  const durBadge =
    s.kind === "video-cut"
      ? formatDurationBadge(s.startSec || 0, s.endSec || 60, lang)
      : lang === "zh"
        ? `${s.readingMinutes || 10} 分钟阅读`
        : `${s.readingMinutes || 10} min read`;

  const sliceSec =
    s.kind === "video-cut"
      ? Math.max(30, (s.endSec || 60) - (s.startSec || 0))
      : (s.readingMinutes || 10) * 60;

  return {
    slug: n.slug,
    order: n.order,
    isSpine: n.isSpine ? 1 : 0,
    era: c?.eraId || "",
    life: c?.lifecycle || "mainstream",
    conceptName: c ? c[lang].shortName : n.primaryConcept,
    domains: n.facets.domains,
    tasks: n.facets.tasks,
    stacks: n.facets.stacks,
    plat: s.isShort ? "shorts" : s.platform,
    kind: s.kind,
    ytId: s.platform === "youtube" ? s.videoId || "" : "",
    durBadge,
    title: n[lang].title,
    ch: s.channelName,
    hours: s.hoursSaved || 0.5,
    dur: sliceSec,
    q: `${n[lang].title} ${n[lang].whyWatch} ${s.channelName} ${c ? c[lang].shortName : ""} ${n[lang].searchQuestions.join(" ")}`.toLowerCase(),
  };
});

const title =
  lang === "zh"
    ? `精选视频库（${NODES.length} 支精华片段）— AITube`
    : `Video Library (${NODES.length} Curated Highlights) — AITube`;
const desc =
  lang === "zh"
    ? `从上千小时公开课与分享中挑出 ${NODES.length} 支核心片段，跳过冗长片头，点开直达重点。`
    : `Browse ${NODES.length} hand-picked AI video highlights — jump straight to the clearest minutes.`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...orgAndSiteGraph(lang),
    buildBreadcrumbSchema([
      { name: "AITube", path: `/${lang}/` },
      { name: t.navDirectory, path: `/${lang}/directory/` },
    ]),
  ],
};
---
<BaseLayout
  title={title}
  description={desc}
  lang={lang}
  pathname={`/${lang}/directory/`}
  ogImage={`/og/directory-${lang}.png`}
  schema={schema}
>
  <section class="at-page-header" style="padding-bottom:24px;border-bottom:1px solid var(--border-subtle);">
    <div class="at-container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:24px;">
        <div style="max-width:58ch;">
          <h1 class="at-page-h1">{t.navDirectory}</h1>
          <p class="at-page-lead" style="margin-top:8px;font-size:0.98rem;">{desc}</p>
        </div>

        <input
          type="search"
          id="dir-query"
          placeholder={lang === "zh" ? "搜索视频标题、作者或概念…" : "Search videos, creators, or topics..."}
          style="width:min(340px, 100%);padding:10px 16px;border:0;border-radius:999px;background:var(--bg-elevated);font-size:0.88rem;outline:none;"
        />
      </div>

      <!-- Clean Single-Row Topic Pills -->
      <div class="at-filter-row" role="group" aria-label="Topic presets">
        {DIRECTORY_SCENARIOS.map((sc, idx) => (
          <button
            type="button"
            class={`at-chip ${idx === 0 ? "is-active" : ""}`}
            data-d-preset={sc.id}
          >
            {stripEmoji(lang === "zh" ? sc.zhTitle : sc.enTitle)}
          </button>
        ))}
      </div>
    </div>
  </section>

  <div class="at-container at-dir-layout">
    <div>
      <button
        type="button"
        id="dir-mobile-toggle"
        class="at-btn-ghost at-mobile-filter-btn"
        style="width:100%;justify-content:space-between;margin-bottom:14px;font-size:0.84rem;"
      >
        <span>{t.mobileFiltersBtn}</span>
        <span id="dir-mobile-badge">▾</span>
      </button>

      <aside class="at-dir-sidebar" id="dir-sidebar" aria-label="Filters">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
          <span style="font-size:0.78rem;font-weight:650;color:var(--ink-muted);">
            {lang === "zh" ? "筛选" : "Filters"}
          </span>
          <button type="button" id="dir-reset" style="border:0;background:transparent;color:var(--accent-primary);font-size:0.78rem;cursor:pointer;padding:0;">
            {t.clearFilters}
          </button>
        </div>

        <details class="at-facet-details" open>
          <summary>{lang === "zh" ? "内容形式" : "Format"}</summary>
          <div>
            <button type="button" class="at-facet-btn is-active" data-d-plat="all">
              <span>{t.allSources}</span>
            </button>
            <button type="button" class="at-facet-btn" data-d-plat="youtube">
              <span>YouTube</span>
            </button>
            <button type="button" class="at-facet-btn" data-d-plat="shorts">
              <span>{lang === "zh" ? "短视频" : "Shorts"}</span>
            </button>
            <button type="button" class="at-facet-btn" data-d-plat="bilibili">
              <span>Bilibili</span>
            </button>
            <button type="button" class="at-facet-btn" data-d-plat="editorial">
              <span>{lang === "zh" ? "深度好文" : "Guides"}</span>
            </button>
          </div>
        </details>

        <details class="at-facet-details" open>
          <summary>{lang === "zh" ? "发展阶段" : "Time Period"}</summary>
          <div>
            {ERAS.map((era) => {
              const eraSlugs = new Set(CONCEPTS.filter((c) => c.eraId === era.id).map((c) => c.slug));
              const cnt = NODES.filter((n) => eraSlugs.has(n.primaryConcept)).length;
              return (
                <button type="button" class="at-facet-btn" data-f-era={era.id} data-f-label={`${era.period} · ${era[lang].title}`}>
                  <span>{era[lang].title}</span>
                  <span class="at-mono" style="font-size:0.74rem;color:var(--ink-muted);">{cnt}</span>
                </button>
              );
            })}
          </div>
        </details>

        {TAXONOMY_DIMS.map((dim, dIdx) => (
          <details class="at-facet-details" open={dIdx === 0}>
            <summary>{dim[lang].label}</summary>
            <div>
              {dim.items.map((item) => {
                const cnt = NODES.filter((n) => n.facets[dim.prop].includes(item.slug)).length;
                return (
                  <button
                    type="button"
                    class="at-facet-btn"
                    data-f-dim={dim.prop}
                    data-f-val={item.slug}
                    data-f-label={item[lang].name}
                  >
                    <span>{item[lang].name}</span>
                    <span class="at-mono" style="font-size:0.74rem;color:var(--ink-muted);">{cnt}</span>
                  </button>
                );
              })}
            </div>
          </details>
        ))}
      </aside>
    </div>

    <div>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <span class="at-mono" id="dir-count" style="font-size:0.86rem;color:var(--ink-secondary);font-weight:500;">
            {lang === "zh" ? `共 ${NODES.length} 支内容` : `${NODES.length} videos`}
          </span>
          <div id="dir-active-pills" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
        </div>

        <select
          id="dir-sort"
          aria-label="Sort order"
          style="padding:6px 12px;border:0;border-radius:999px;background:var(--bg-elevated);font-size:0.82rem;color:var(--ink-secondary);cursor:pointer;"
        >
          <option value="editorial">{t.sortEditorial}</option>
          <option value="shortest">{t.sortShortest}</option>
          <option value="saved">{t.sortSaved}</option>
        </select>
      </div>

      <div class="at-grid-cards" id="dir-grid">
        {initialNodes.map((n) => (
          <MediaCard node={n} lang={lang} />
        ))}
      </div>

      <div style="margin-top:36px;text-align:center;">
        <button type="button" id="dir-load-more" class="at-btn-ghost">
          {t.loadMore}
        </button>
      </div>
    </div>
  </div>

  <script type="application/json" id="dir-catalog-json" set:html={JSON.stringify(clientCatalog)} />

  <script is:inline define:vars={{ lang, basePrefix, doneBadgeText }}>
    (() => {
      const raw = document.getElementById("dir-catalog-json");
      const grid = document.getElementById("dir-grid");
      const loadBtn = document.getElementById("dir-load-more");
      const countEl = document.getElementById("dir-count");
      const queryEl = document.getElementById("dir-query");
      const sortEl = document.getElementById("dir-sort");
      const resetEl = document.getElementById("dir-reset");
      const activeBox = document.getElementById("dir-active-pills");
      const sidebar = document.getElementById("dir-sidebar");
      const mobBtn = document.getElementById("dir-mobile-toggle");
      const mobBadge = document.getElementById("dir-mobile-badge");
      if (!raw || !grid || !loadBtn) return;

      const catalog = JSON.parse(raw.textContent || "[]");
      const PAGE_SIZE = 24;
      let limit = PAGE_SIZE;

      const state = {
        era: null,
        eraLabel: "",
        plat: "all",
        q: "",
        sort: "editorial",
        domains: new Map(),
        tasks: new Map(),
        stacks: new Map(),
      };

      function esc(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function getCompletedSet() {
        try {
          return new Set(JSON.parse(localStorage.getItem("aitube-completed-v1") || "[]"));
        } catch {
          return new Set();
        }
      }

      function cardHTML(item, completedSet) {
        const doneAttr = completedSet.has(item.slug) ? ' data-completed="1"' : "";
        const thumb = item.ytId
          ? `<img src="https://i.ytimg.com/vi/${esc(item.ytId)}/hqdefault.jpg" alt="${esc(item.title)}" loading="lazy" decoding="async" class="at-card-thumb" onerror="this.remove()" />`
          : "";
        const glyph =
          item.kind === "article-digest"
            ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" /></svg>`
            : `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19 8 5" /></svg>`;

        return `
          <article class="at-card" data-node-slug="${esc(item.slug)}"${doneAttr}>
            <a href="${basePrefix}/${lang}/nodes/${esc(item.slug)}/" class="at-card-link">
              <div class="at-card-poster">
                ${thumb}
                <span class="at-card-play-glyph" aria-hidden="true">${glyph}</span>
                <span class="at-card-done-pill">✓ ${esc(doneBadgeText)}</span>
                <span class="at-card-dur">${esc(item.durBadge)}</span>
              </div>
              <div class="at-card-body">
                <h3 class="at-card-title">${esc(item.title)}</h3>
                <div class="at-card-meta">${esc(item.ch)} · ${esc(item.conceptName)}</div>
              </div>
            </a>
          </article>
        `;
      }

      function renderActivePills() {
        if (!activeBox) return;
        const pills = [];
        if (state.era) {
          pills.push({ key: "era", val: state.era, label: state.eraLabel });
        }
        for (const dim of ["domains", "tasks", "stacks"]) {
          for (const [val, label] of state[dim].entries()) {
            pills.push({ key: dim, val, label });
          }
        }
        if (mobBadge) {
          mobBadge.textContent = pills.length ? `(${pills.length}) ▾` : "▾";
        }
        activeBox.innerHTML = pills
          .map(
            (p) =>
              `<button type="button" class="at-active-pill" data-rm-key="${esc(p.key)}" data-rm-val="${esc(p.val)}">${esc(p.label)} ×</button>`
          )
          .join("");
      }

      function getFiltered() {
        const filtered = catalog.filter((it) => {
          if (state.era && it.era !== state.era) return false;
          if (state.plat !== "all" && it.plat !== state.plat) return false;
          if (state.domains.size > 0 && ![...state.domains.keys()].some((k) => it.domains.includes(k))) return false;
          if (state.tasks.size > 0 && ![...state.tasks.keys()].some((k) => it.tasks.includes(k))) return false;
          if (state.stacks.size > 0 && ![...state.stacks.keys()].some((k) => it.stacks.includes(k))) return false;
          if (state.q && !it.q.includes(state.q)) return false;
          return true;
        });

        if (state.sort === "saved") {
          filtered.sort((a, b) => b.hours - a.hours || a.order - b.order);
        } else if (state.sort === "shortest") {
          filtered.sort((a, b) => a.dur - b.dur || a.order - b.order);
        } else {
          filtered.sort((a, b) => b.isSpine - a.isSpine || a.order - b.order);
        }
        return filtered;
      }

      function syncButtons() {
        document.querySelectorAll("[data-f-era]").forEach((b) => {
          b.classList.toggle("is-active", b.getAttribute("data-f-era") === state.era);
        });
        document.querySelectorAll("[data-d-plat]").forEach((b) => {
          b.classList.toggle("is-active", b.getAttribute("data-d-plat") === state.plat);
        });
        document.querySelectorAll("[data-f-dim]").forEach((b) => {
          const dim = b.getAttribute("data-f-dim");
          const val = b.getAttribute("data-f-val");
          b.classList.toggle("is-active", Boolean(dim && val && state[dim]?.has(val)));
        });
      }

      function render() {
        const filtered = getFiltered();
        const completedSet = getCompletedSet();
        const slice = filtered.slice(0, limit);
        grid.innerHTML = slice.length
          ? slice.map((it) => cardHTML(it, completedSet)).join("")
          : `<p style="grid-column:1/-1;padding:36px 0;text-align:center;color:var(--ink-muted);">${
              lang === "zh" ? "未找到匹配视频，请尝试重置筛选条件。" : "No matching videos found. Try resetting filters."
            }</p>`;
        if (countEl) {
          countEl.textContent = lang === "zh" ? `共 ${filtered.length} 支内容` : `${filtered.length} videos`;
        }
        loadBtn.style.display = filtered.length > limit ? "inline-flex" : "none";
        renderActivePills();
        syncButtons();
      }

      mobBtn?.addEventListener("click", () => {
        sidebar?.classList.toggle("is-open");
      });

      document.querySelectorAll("[data-f-era]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-f-era");
          const lbl = btn.getAttribute("data-f-label") || id || "";
          state.era = state.era === id ? null : id;
          state.eraLabel = state.era ? lbl : "";
          limit = PAGE_SIZE;
          render();
        });
      });

      document.querySelectorAll("[data-f-dim]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const dim = btn.getAttribute("data-f-dim");
          const val = btn.getAttribute("data-f-val");
          const lbl = btn.getAttribute("data-f-label") || val || "";
          if (!dim || !val || !state[dim]) return;
          if (state[dim].has(val)) state[dim].delete(val);
          else state[dim].set(val, lbl);
          limit = PAGE_SIZE;
          render();
        });
      });

      document.querySelectorAll("[data-d-plat]").forEach((btn) => {
        btn.addEventListener("click", () => {
          state.plat = btn.getAttribute("data-d-plat") || "all";
          limit = PAGE_SIZE;
          render();
        });
      });

      activeBox?.addEventListener("click", (e) => {
        const pill = e.target.closest("[data-rm-key]");
        if (!pill) return;
        const k = pill.getAttribute("data-rm-key");
        const v = pill.getAttribute("data-rm-val");
        if (k === "era") {
          state.era = null;
          state.eraLabel = "";
        } else if (k && v && state[k]) {
          state[k].delete(v);
        }
        limit = PAGE_SIZE;
        render();
      });

      queryEl?.addEventListener("input", () => {
        state.q = queryEl.value.trim().toLowerCase();
        limit = PAGE_SIZE;
        render();
      });

      sortEl?.addEventListener("change", () => {
        state.sort = sortEl.value || "editorial";
        limit = PAGE_SIZE;
        render();
      });

      function clearAllState() {
        state.era = null;
        state.eraLabel = "";
        state.plat = "all";
        state.q = "";
        state.sort = "editorial";
        state.domains.clear();
        state.tasks.clear();
        state.stacks.clear();
        if (queryEl) queryEl.value = "";
        if (sortEl) sortEl.value = "editorial";
      }

      function applyScenarioPreset(presetId) {
        clearAllState();
        document.querySelectorAll("[data-d-preset]").forEach((b) => {
          b.classList.toggle("is-active", b.getAttribute("data-d-preset") === presetId);
        });
        const findLabel = (dim, val) => {
          const btn = document.querySelector(`[data-f-dim="${dim}"][data-f-val="${val}"]`);
          return btn?.getAttribute("data-f-label") || val;
        };
        if (presetId === "beginner") {
          state.domains.set("foundations", findLabel("domains", "foundations"));
        } else if (presetId === "coding") {
          state.tasks.set("agentic-coding", findLabel("tasks", "agentic-coding"));
        } else if (presetId === "rag-agent") {
          state.tasks.set("rag-knowledge", findLabel("tasks", "rag-knowledge"));
          state.tasks.set("tool-mcp-skills", findLabel("tasks", "tool-mcp-skills"));
        } else if (presetId === "multimodal") {
          state.tasks.set("multimodal-creation", findLabel("tasks", "multimodal-creation"));
        } else if (presetId === "frontier") {
          state.era = "era-2025h2-2026";
          const eraBtn = document.querySelector('[data-f-era="era-2025h2-2026"]');
          state.eraLabel = eraBtn?.getAttribute("data-f-label") || "2025 H2–2026";
        }
        limit = PAGE_SIZE;
        render();
      }

      document.querySelectorAll("[data-d-preset]").forEach((btn) => {
        btn.addEventListener("click", () => {
          applyScenarioPreset(btn.getAttribute("data-d-preset") || "all");
        });
      });

      resetEl?.addEventListener("click", () => {
        applyScenarioPreset("all");
      });

      loadBtn.addEventListener("click", () => {
        limit += PAGE_SIZE;
        render();
      });

      try {
        const sp = new URLSearchParams(window.location.search);
        const qPreset = sp.get("preset");
        if (qPreset) applyScenarioPreset(qPreset);
        else render();
      } catch {
        render();
      }
    })();
  </script>
</BaseLayout>
