---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MediaCard from "../../../components/MediaCard.astro";
import { LANGS, LIFECYCLE_META, ROLE_META, UI, formatTime, withBase, type Lang } from "../../../lib/i18n";
import {
  CONCEPTS,
  SERIES_LABELS,
  buildSparklineGeometry,
  getConcept,
  getEra,
  getNodesForConcept,
  splitParadigmShift,
} from "../../../lib/content";
import { buildConceptSchema } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    CONCEPTS.map((c) => ({
      params: { lang, slug: c.slug },
    }))
  );
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const concept = getConcept(slug)!;
const loc = concept[lang];
const t = UI[lang];
const era = getEra(concept.eraId);
const life = LIFECYCLE_META[concept.lifecycle];
const shift = splitParadigmShift(loc.paradigmShift);
const allNodes = getNodesForConcept(concept.slug);
const galleryNodes = allNodes.slice(0, 24);

const chart = buildSparklineGeometry(concept.trendSeries, 360, 96, 8);
const inflectPt = chart.points[concept.inflectionIndex] || chart.points[chart.points.length - 1];
const pathname = `/${lang}/concepts/${concept.slug}/`;
const schema = buildConceptSchema(concept, allNodes, lang, pathname);
---
<BaseLayout
  title={`${loc.name} — AITube`}
  description={`${loc.oneLiner} ${loc.whyNow}`}
  lang={lang}
  pathname={pathname}
  ogImage={`/og/concepts/${concept.slug}.png`}
  schema={schema}
>
  <section class="at-page-header" style="border-bottom:1px solid var(--border-subtle);">
    <div class="at-container">
      <nav style="font-size:0.82rem;color:var(--ink-muted);margin-bottom:16px;display:flex;gap:6px;align-items:center;">
        <a href={withBase(`/${lang}/timeline/`)}>{t.navTimeline}</a>
        <span>/</span>
        <span>{loc.shortName}</span>
      </nav>

      <div style="display:grid;grid-template-columns:minmax(0, 1.3fr) minmax(0, 0.85fr);gap:40px;align-items:start;" class="at-concept-top">
        <div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:10px;">
            <span class={`at-life at-life-${concept.lifecycle}`}>{life[lang]}</span>
            {era && (
              <a href={withBase(`/${lang}/timeline/#${era.id}`)} style="font-size:0.8rem;color:var(--ink-muted);">
                {era.period} · {era[lang].title}
              </a>
            )}
          </div>

          <h1 class="at-page-h1" style="font-size:clamp(1.85rem,3vw,2.45rem);">{loc.name}</h1>
          <p style="margin-top:12px;font-size:1.02rem;color:var(--ink-secondary);line-height:1.6;">{loc.oneLiner}</p>

          <div class="at-shift-bar" style="background:var(--bg-elevated);margin-top:18px;">
            <strong style="color:var(--ink-primary);font-weight:600;">
              {lang === "zh" ? "现在做法：" : "Current practice: "}
            </strong>
            <span>{shift.after}</span>
          </div>

          <p style="margin-top:14px;font-size:0.9rem;color:var(--ink-secondary);line-height:1.58;">
            <strong style="color:var(--ink-primary);">{lang === "zh" ? "为什么值得看：" : "Why it matters: "}</strong>
            {loc.whyNow}
          </p>

          {(concept.lineage.from.length > 0 || concept.lineage.into.length > 0) && (
            <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:8px;">
              {concept.lineage.from.map((s) => {
                const up = getConcept(s);
                return up ? (
                  <a href={withBase(`/${lang}/concepts/${up.slug}/`)} class="at-lineage-pill" style="background:var(--bg-elevated);">
                    {t.lineageFrom}：{up[lang].shortName}
                  </a>
                ) : null;
              })}
              {concept.lineage.into.map((s) => {
                const dn = getConcept(s);
                return dn ? (
                  <a href={withBase(`/${lang}/concepts/${dn.slug}/`)} class="at-lineage-pill" style="background:var(--bg-elevated);">
                    {t.lineageInto}：{dn[lang].shortName}
                  </a>
                ) : null;
              })}
            </div>
          )}
        </div>

        <div
          class="at-side-card"
          data-spark-box
          data-pts={JSON.stringify(chart.points)}
          data-labels={JSON.stringify(SERIES_LABELS)}
          data-default-mom={concept.momentum}
          data-inflect-idx={concept.inflectionIndex}
        >
          <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.78rem;color:var(--ink-muted);margin-bottom:10px;gap:8px;flex-wrap:wrap;">
            <span>{lang === "zh" ? `${concept.originQuarter} 提出` : `Proposed ${concept.originQuarter}`}</span>
            <span data-sp-mid style="color:var(--ink-primary);font-weight:600;">{concept.momentum}</span>
          </div>
          <svg
            width="100%"
            viewBox="0 0 360 96"
            style="display:block;cursor:crosshair;"
            role="img"
            aria-label="Concept trend curve"
            data-spark-svg
          >
            <path d={chart.areaPath} fill="var(--accent-primary-soft)" />
            <path
              d={chart.path}
              fill="none"
              stroke="var(--accent-primary)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
            <line
              data-sp-guide
              x1={inflectPt.x}
              y1="6"
              x2={inflectPt.x}
              y2="90"
              stroke="var(--accent-signal)"
              stroke-width="1"
              stroke-dasharray="3 3"
              opacity="0.45"
            />
            <circle
              data-sp-dot
              cx={inflectPt.x}
              cy={inflectPt.y}
              r="4.8"
              fill="var(--accent-signal)"
            />
          </svg>
          <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.7rem;color:var(--ink-muted);margin-top:8px;">
            <span>2022</span>
            <span>{lang === "zh" ? `${concept.inflectionQuarter} 爆发` : `Breakout ${concept.inflectionQuarter}`}</span>
            <span>2026</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="at-container" style="padding:40px 28px 68px;">
    <div class="at-section-head">
      <h2>
        {lang === "zh" ? `精选视频与解读（${allNodes.length}）` : `Curated Videos & Guides (${allNodes.length})`}
      </h2>
      <div class="at-segmented" role="group" aria-label="Filter by type" style="padding:3px;">
        <button type="button" class="at-seg-btn is-active" data-role-filter="all" style="padding:5px 14px;font-size:0.82rem;">
          {lang === "zh" ? "全部" : "All"}
        </button>
        {(["origin", "practice", "frontier"] as const).map((r) => (
          <button type="button" class="at-seg-btn" data-role-filter={r} style="padding:5px 14px;font-size:0.82rem;">
            {ROLE_META[r][lang]}
          </button>
        ))}
      </div>
    </div>

    <div class="at-grid-cards" id="concept-cards-grid">
      {galleryNodes.map((n) => (
        <div data-card-role={n.conceptRole} style="display:flex;">
          <MediaCard node={n} lang={lang} />
        </div>
      ))}
    </div>

    {allNodes.length > 24 && (
      <details style="margin-top:36px;border-radius:14px;padding:16px 20px;background:var(--bg-elevated);">
        <summary style="cursor:pointer;font-weight:600;font-size:0.9rem;">
          {t.fullArchiveSummary} ({allNodes.length})
        </summary>
        <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;">
          {allNodes.map((n, idx) => (
            <a
              href={withBase(`/${lang}/nodes/${n.slug}/`)}
              style="display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--border-subtle);font-size:0.86rem;"
            >
              <span>
                <span class="at-mono" style="color:var(--ink-muted);margin-right:8px;">{String(idx + 1).padStart(2, "0")}</span>
                {n[lang].title}
              </span>
              <span class="at-mono" style="color:var(--ink-muted);white-space:nowrap;">
                {n.source.channelName} ·{" "}
                {n.source.kind === "video-cut"
                  ? `${formatTime(n.source.startSec || 0)}–${formatTime(n.source.endSec || 0)}`
                  : `${n.source.readingMinutes}m`}
              </span>
            </a>
          ))}
        </div>
      </details>
    )}
  </section>

  <script is:inline>
    (() => {
      const btns = [...document.querySelectorAll("[data-role-filter]")];
      const items = [...document.querySelectorAll("[data-card-role]")];
      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const val = btn.getAttribute("data-role-filter") || "all";
          btns.forEach((b) => b.classList.toggle("is-active", b === btn));
          items.forEach((el) => {
            el.style.display = val === "all" || el.getAttribute("data-card-role") === val ? "flex" : "none";
          });
        });
      });
    })();
  </script>
</BaseLayout>
