---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MediaCard from "../../../../components/MediaCard.astro";
import { LANGS, UI, formatTime, withBase, type Lang } from "../../../../lib/i18n";
import { TAXONOMY_DIMS, getFacetItem, getNodesByFacet } from "../../../../lib/content";
import { absUrl, buildBreadcrumbSchema, orgAndSiteGraph } from "../../../../lib/seo";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    TAXONOMY_DIMS.flatMap((dim) =>
      dim.items
        .filter((item) => getNodesByFacet(dim.key, item.slug).length >= 3)
        .map((item) => ({
          params: { lang, dimension: dim.key, slug: item.slug },
        }))
    )
  );
}

const lang = Astro.params.lang as Lang;
const dimension = Astro.params.dimension as "domain" | "task" | "stack";
const slug = Astro.params.slug as string;
const t = UI[lang];

const found = getFacetItem(dimension, slug)!;
const allNodes = getNodesByFacet(dimension, slug);
const galleryNodes = allNodes.slice(0, 24);
const pathname = `/${lang}/topics/${dimension}/${slug}/`;

const title = `${found.item[lang].name} — AITube`;
const desc = found.item[lang].desc;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...orgAndSiteGraph(lang),
    buildBreadcrumbSchema([
      { name: "AITube", path: `/${lang}/` },
      { name: t.navDirectory, path: `/${lang}/directory/` },
      { name: found.item[lang].name, path: pathname },
    ]),
    {
      "@type": "CollectionPage",
      name: title,
      url: absUrl(pathname),
      description: desc,
    },
  ],
};
---
<BaseLayout
  title={title}
  description={desc}
  lang={lang}
  pathname={pathname}
  ogImage={`/og/directory-${lang}.png`}
  schema={schema}
>
  <section class="at-page-header" style="border-bottom:1px solid var(--border-subtle);">
    <div class="at-container">
      <nav style="font-size:0.82rem;color:var(--ink-muted);margin-bottom:14px;display:flex;gap:6px;align-items:center;">
        <a href={withBase(`/${lang}/directory/`)}>{t.navDirectory}</a>
        <span>/</span>
        <span>{found.item[lang].name}</span>
      </nav>
      <div class="at-kicker" style="margin-bottom:6px;">
        {found.dim[lang].label} · {allNodes.length}
      </div>
      <h1 class="at-page-h1">{found.item[lang].name}</h1>
      <p class="at-page-lead" style="max-width:64ch;">{desc}</p>
    </div>
  </section>

  <section class="at-container" style="padding:36px 28px 68px;">
    <div class="at-grid-cards">
      {galleryNodes.map((n) => (
        <MediaCard node={n} lang={lang} />
      ))}
    </div>

    {allNodes.length > 24 && (
      <details style="margin-top:36px;border-radius:14px;padding:16px 20px;background:var(--bg-elevated);">
        <summary style="cursor:pointer;font-weight:600;font-size:0.9rem;">
          {t.fullArchiveSummary} ({allNodes.length})
        </summary>
        <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;">
          {allNodes.map((n, idx) => (
            <a
              href={withBase(`/${lang}/nodes/${n.slug}/`)}
              style="display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--border-subtle);font-size:0.86rem;"
            >
              <span>
                <span class="at-mono" style="color:var(--ink-muted);margin-right:8px;">{String(idx + 1).padStart(2, "0")}</span>
                {n[lang].title}
              </span>
              <span class="at-mono" style="color:var(--ink-muted);">
                {n.source.kind === "video-cut"
                  ? `${formatTime(n.source.startSec || 0)}–${formatTime(n.source.endSec || 0)}`
                  : `${n.source.readingMinutes}m`}
              </span>
            </a>
          ))}
        </div>
      </details>
    )}
  </section>
</BaseLayout>
