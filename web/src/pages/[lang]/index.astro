---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonaCompass from "../../components/PersonaCompass.astro";
import { LANGS, UI, withBase, type Lang } from "../../lib/i18n";
import { CONCEPTS, ERAS, NODES, VAULT_ITEMS } from "../../lib/content";
import { DIRECTORY_SCENARIOS } from "../../lib/personas";
import { orgAndSiteGraph } from "../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

const stripEmoji = (s: string) => s.replace(/^[^\w\u4e00-\u9fff]+\s*/, "");

const collections = [
  ...DIRECTORY_SCENARIOS.filter((s) => s.id !== "all").map((sc) => ({
    href: withBase(`/${lang}/directory/?preset=${sc.id}`),
    title: stripEmoji(lang === "zh" ? sc.zhTitle : sc.enTitle),
    sub: lang === "zh" ? sc.zhSub : sc.enSub,
    cta: lang === "zh" ? "浏览视频" : "Browse videos",
  })),
  {
    href: withBase(`/${lang}/vault/`),
    title: lang === "zh" ? "拿来即用的项目模板箱" : "Ready-to-Use Templates",
    sub: lang === "zh" ? `AGENTS.md · SKILL.md 等 ${VAULT_ITEMS.length} 份现成模板` : `${VAULT_ITEMS.length} copy-paste templates & prompts`,
    cta: lang === "zh" ? "查看模板" : "Open templates",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": orgAndSiteGraph(lang),
};
---
<BaseLayout
  title={`${t.siteName} — ${t.tagline}`}
  description={t.heroSubtitle}
  lang={lang}
  pathname={`/${lang}/`}
  ogImage={`/og/home-${lang}.png`}
  schema={schema}
>
  <!-- Shelf 1: Minimal Hero + Segmented Track Switcher + 3 Featured Videos -->
  <section class="at-home-hero">
    <div class="at-container">
      <div class="at-home-intro">
        <h1 class="at-page-h1">{t.heroTitle}</h1>
        <p class="at-page-lead">{t.heroSubtitle}</p>

        <button type="button" class="at-home-search" data-open-search>
          <span style="display:inline-flex;align-items:center;gap:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5" />
              <path d="m20 20-3.8-3.8" />
            </svg>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{t.searchPlaceholder}</span>
          </span>
          <span class="at-kbd">⌘K</span>
        </button>
      </div>

      <PersonaCompass lang={lang} />
    </div>
  </section>

  <!-- Shelf 2: Signature 2017–2026 5-Stage Chronological Overview -->
  <section class="at-section-soft">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <h2>{t.eraStripHeading}</h2>
          <p style="color:var(--ink-secondary);font-size:0.94rem;margin-top:4px;">
            {lang === "zh"
              ? "按出现与普及的时间顺序，看清今天的热门技术是怎么一步步长出来的。"
              : "See how today's most important AI techniques grew step by step."}
          </p>
        </div>
        <a href={withBase(`/${lang}/timeline/`)} class="at-text-link">
          {t.ctaTimeline}
        </a>
      </div>

      <div class="at-era-strip">
        {ERAS.map((era) => {
          const eraConcepts = CONCEPTS.filter((c) => c.eraId === era.id);
          return (
            <a href={withBase(`/${lang}/timeline/#${era.id}`)} class="at-era-card">
              <span class="at-era-year">{era.period}</span>
              <h3 class="at-era-title">{era[lang].title}</h3>
              <p class="at-era-desc">{era[lang].subtitle}</p>
              <div class="at-era-tags">
                {eraConcepts.slice(0, 3).map((c) => (
                  <span class="at-era-tag">{c[lang].shortName}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Shelf 3: 6 Calm Topic Collections -->
  <section class="at-section" style="border-top:0;">
    <div class="at-container">
      <div class="at-section-head">
        <h2>{lang === "zh" ? "按主题探索" : "Explore by Topic"}</h2>
        <a href={withBase(`/${lang}/directory/`)} class="at-text-link">
          {lang === "zh" ? `全部 ${NODES.length} 支视频 ›` : `All ${NODES.length} videos ›`}
        </a>
      </div>

      <div class="at-collections-grid">
        {collections.map((col) => (
          <a href={col.href} class="at-collection-card">
            <div>
              <h3 style="font-size:1.08rem;margin-bottom:6px;">{col.title}</h3>
              <p style="font-size:0.86rem;color:var(--ink-secondary);">{col.sub}</p>
            </div>
            <span class="at-text-link" style="font-size:0.84rem;">
              {col.cta} ›
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
