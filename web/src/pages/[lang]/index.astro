---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonaCompass from "../../components/PersonaCompass.astro";
import HeroWaveRadar from "../../components/HeroWaveRadar.astro";
import { LANGS, UI, withBase, type Lang } from "../../lib/i18n";
import { CONCEPTS, ERAS, NODES } from "../../lib/content";
import { DIRECTORY_SCENARIOS, SHIFT_CHEATSHEET } from "../../lib/personas";
import { orgAndSiteGraph } from "../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const romanEras = ["I", "II", "III", "IV", "V"];

const heroPrompts =
  lang === "zh"
    ? [
        { label: "🌱 大模型原理通俗解释", q: "Karpathy 预训练" },
        { label: "⚡ 零幻觉搭个人知识库", q: "NotebookLM" },
        { label: "🧭 智能体评测怎么做？", q: "Hamel Evals" },
        { label: "🔭 Prompt 与 Context 区别", q: "Context Engineering" },
      ]
    : [
        { label: "🌱 How LLMs actually work", q: "Karpathy three stage" },
        { label: "⚡ Zero-hallucination docs workflow", q: "NotebookLM" },
        { label: "🧭 How to run LLM Evals", q: "Hamel Evals" },
        { label: "🔭 Prompt vs Context Engineering", q: "Context Engineering" },
      ];

const scenarioCards = DIRECTORY_SCENARIOS.filter((s) => s.id !== "all");

const schema = {
  "@context": "https://schema.org",
  "@graph": orgAndSiteGraph(lang),
};
---
<BaseLayout
  title={`${t.siteName} — ${t.tagline}`}
  description={t.heroSubtitle}
  lang={lang}
  pathname={`/${lang}/`}
  ogImage={`/og/home-${lang}.png`}
  schema={schema}
>
  <!-- ZONE 1: Calm Centered Header + 4-Persona Interactive Triage Compass -->
  <section class="at-home-hero">
    <div class="at-container">
      <div class="at-home-intro">
        <div class="at-kicker">{t.heroKicker}</div>
        <h1 class="at-home-h1">{t.heroTitle}</h1>
        <p class="at-home-sub">{t.heroSubtitle}</p>

        <div class="at-home-search-wrap">
          <button type="button" class="at-hero-search-btn at-hero-search-centered" data-open-search>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              ⌕ {t.searchPlaceholder}
            </span>
            <span class="at-kbd">⌘K</span>
          </button>

          <div class="at-prompt-row" style="justify-content:center;margin-bottom:0;" aria-label="Suggested queries">
            {heroPrompts.map((hp) => (
              <button type="button" class="at-prompt-chip" data-open-search data-search-q={hp.q}>
                {hp.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <PersonaCompass lang={lang} />
    </div>
  </section>

  <!-- ZONE 2: "Learn New, Skip Old" 4-Row Paradigm Cheat Sheet + 4-Wave Radar -->
  <section class="at-section">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <div class="at-kicker" style="color:var(--accent-signal);">
            {lang === "zh" ? "STEP 2 · 30 秒看清技术风向（避免花时间学过时套路）" : "STEP 2 · LEARN WHAT'S CURRENT, SKIP WHAT'S OUTDATED"}
          </div>
          <h2>{t.eraStripHeading}</h2>
        </div>
        <a href={withBase(`/${lang}/timeline/`)} class="at-mono" style="color:var(--accent-primary);font-size:0.86rem;font-weight:600;">
          {t.ctaTimeline}
        </a>
      </div>

      <div class="at-cheatsheet-grid">
        <div class="at-cheatsheet-card">
          <div class="at-cheatsheet-head at-mono">
            <span>{lang === "zh" ? "✕ 别再死磕的旧习惯（2023–2024）" : "✕ OUTDATED HABITS (2023–24)"}</span>
            <span style="color:var(--accent-primary);">{lang === "zh" ? "✓ 2026 现在该掌握的重点" : "✓ FOCUS ON THIS IN 2026"}</span>
          </div>

          <div class="at-cheatsheet-list">
            {SHIFT_CHEATSHEET.map((row) => (
              <a href={withBase(`/${lang}/concepts/${row.conceptSlug}/`)} class="at-cheatsheet-row">
                <div class="at-cheatsheet-old">
                  {lang === "zh" ? row.zhOld : row.enOld}
                </div>
                <div class="at-mono" style="color:var(--accent-signal);font-weight:700;">→</div>
                <div class="at-cheatsheet-new">
                  <span>{lang === "zh" ? row.zhNew : row.enNew}</span>
                  <span class="at-mono at-cheatsheet-tag">{row.tag}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <HeroWaveRadar lang={lang} />
      </div>

      <!-- Clean 5-Era Macro Story Strip -->
      <div class="at-era-strip" style="margin-top:20px;">
        {ERAS.map((era, idx) => {
          const cnt = CONCEPTS.filter((c) => c.eraId === era.id).length;
          return (
            <a href={withBase(`/${lang}/timeline/#${era.id}`)} class="at-era-card">
              <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.72rem;color:var(--accent-signal);font-weight:650;">
                <span>ERA {romanEras[idx]} · {era.period}</span>
                <span style="color:var(--ink-muted);">{cnt} {lang === "zh" ? "概念" : "concepts"}</span>
              </div>
              <strong style="font-family:var(--font-serif);font-size:1.05rem;">{era[lang].title}</strong>
              <p style="font-size:0.8rem;color:var(--ink-secondary);line-height:1.45;">{era[lang].subtitle}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ZONE 3: Direct Scenario Doors (5 Clean Cards -> Filtered Directory) -->
  <section class="at-section" style="border-bottom:0;">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <div class="at-kicker">
            {lang === "zh" ? "STEP 3 · 按具体问题直接找实战切片" : "STEP 3 · JUMP DIRECTLY BY PRACTICAL GOAL"}
          </div>
          <h2>
            {lang === "zh" ? "知道自己想解决什么问题？按场景一键筛出好片" : "Know Your Goal? Jump Straight Into Verified Cuts"}
          </h2>
        </div>
        <a href={withBase(`/${lang}/directory/`)} class="at-mono" style="color:var(--accent-primary);font-size:0.86rem;font-weight:600;">
          {lang === "zh" ? `浏览全库 ${NODES.length} 支切片 →` : `All ${NODES.length} cuts →`}
        </a>
      </div>

      <div class="at-scenario-doors">
        {scenarioCards.map((sc) => (
          <a href={withBase(`/${lang}/directory/?preset=${sc.id}`)} class="at-scenario-door">
            <div style="font-weight:650;font-size:1.02rem;color:var(--ink-primary);">
              {lang === "zh" ? sc.zhTitle : sc.enTitle}
            </div>
            <div style="font-size:0.82rem;color:var(--ink-secondary);margin-top:4px;">
              {lang === "zh" ? sc.zhSub : sc.enSub}
            </div>
            <div class="at-mono" style="margin-top:12px;font-size:0.75rem;color:var(--accent-primary);font-weight:600;">
              {lang === "zh" ? "进入精选片单 →" : "Open cuts →"}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
