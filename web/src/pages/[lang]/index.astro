---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaCard from "../../components/MediaCard.astro";
import ConceptHorizonMap from "../../components/ConceptHorizonMap.astro";
import ConceptTimelineCard from "../../components/ConceptTimelineCard.astro";
import HeroWaveRadar from "../../components/HeroWaveRadar.astro";
import { LANGS, UI, withBase, type Lang } from "../../lib/i18n";
import {
  CONCEPTS,
  ERAS,
  NODES,
  SPINE_NODES,
  STAGES,
  TAXONOMY_DIMS,
} from "../../lib/content";
import { orgAndSiteGraph } from "../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];
const romanEras = ["I", "II", "III", "IV", "V"];

const heroPrompts =
  lang === "zh"
    ? [
        { label: "MCP 撑爆上下文怎么办？", q: "Context Engineering MCP" },
        { label: "Prompt vs Context 区别", q: "Context Engineering" },
        { label: "DeepSeek R1 RLVR 原理", q: "RLVR DeepSeek" },
        { label: "SKILL.md 渐进加载规范", q: "SKILL.md" },
      ]
    : [
        { label: "MCP bloating context?", q: "Context Engineering MCP" },
        { label: "Prompt vs Context Eng", q: "Context Engineering" },
        { label: "How RLVR works (o1 / R1)", q: "RLVR DeepSeek" },
        { label: "SKILL.md progressive loading", q: "SKILL.md" },
      ];

const surgingConcepts = CONCEPTS.filter((c) => c.lifecycle === "surging").slice(0, 4);
const featuredSlugs = [
  "3b1b-transformer-overview",
  "karpathy-deep-dive-llms",
  "deepseek-r1-rlvr-paper",
  "anthropic-context-engineering-digest",
  "anthropic-mcp-workshop-mahesh",
  "anthropic-effective-agents-digest",
  "agent-skills-open-spec-digest",
  "comfyui-flux-consistent-pipeline",
];
const featuredNodes = featuredSlugs
  .map((s) => NODES.find((n) => n.slug === s))
  .filter(Boolean)
  .concat(SPINE_NODES.slice(0, 8))
  .filter((v, idx, arr) => v && arr.findIndex((x) => x?.slug === v.slug) === idx)
  .slice(0, 9);

const schema = {
  "@context": "https://schema.org",
  "@graph": orgAndSiteGraph(lang),
};
---
<BaseLayout
  title={`${t.siteName} — ${t.tagline}`}
  description={t.heroSubtitle}
  lang={lang}
  pathname={`/${lang}/`}
  ogImage={`/og/home-${lang}.png`}
  schema={schema}
>
  <section class="at-hero">
    <div class="at-container at-hero-grid">
      <div>
        <div class="at-kicker">{t.heroKicker}</div>
        <h1>{t.heroTitle}</h1>
        <p class="at-hero-lead">{t.heroSubtitle}</p>

        <button type="button" class="at-hero-search-btn" data-open-search>
          <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            ⌕ {t.searchPlaceholder}
          </span>
          <span class="at-kbd">⌘K</span>
        </button>

        <div class="at-prompt-row" aria-label="Suggested engineering queries">
          <span class="at-mono" style="font-size:0.7rem;color:var(--ink-muted);">
            {lang === "zh" ? "试搜:" : "TRY:"}
          </span>
          {heroPrompts.map((hp) => (
            <button type="button" class="at-prompt-chip" data-open-search data-search-q={hp.q}>
              {hp.label}
            </button>
          ))}
        </div>

        <div class="at-hero-ctas">
          <a href={withBase(`/${lang}/timeline/`)} class="at-btn-primary">{t.ctaTimeline}</a>
          <a href={withBase(`/${lang}/directory/`)} class="at-btn-ghost">{t.ctaDirectory}</a>
        </div>
      </div>

      <HeroWaveRadar lang={lang} />
    </div>
  </section>

  <!-- Signature Interactive Horizon Map + 5-Era Stepper -->
  <section class="at-section">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <div class="at-kicker">SIGNATURE PERSPECTIVE · INTERACTIVE LINEAGE</div>
          <h2>{t.eraStripHeading}</h2>
        </div>
        <a href={withBase(`/${lang}/timeline/`)} class="at-mono" style="color:var(--accent-primary);font-size:0.86rem;font-weight:600;">
          {t.ctaTimeline}
        </a>
      </div>

      <div style="margin-bottom:18px;">
        <ConceptHorizonMap lang={lang} mode="home" />
      </div>

      <div class="at-era-strip">
        {ERAS.map((era, idx) => {
          const eraConcepts = CONCEPTS.filter((c) => c.eraId === era.id);
          return (
            <a href={withBase(`/${lang}/timeline/#${era.id}`)} class="at-era-card">
              <span class="at-mono" style="font-size:0.72rem;color:var(--accent-signal);font-weight:650;">
                ERA {romanEras[idx]} · {era.period}
              </span>
              <strong style="font-family:var(--font-serif);font-size:1.08rem;">{era[lang].title}</strong>
              <p style="font-size:0.8rem;color:var(--ink-secondary);line-height:1.46;">{era[lang].subtitle}</p>
              <div style="margin-top:auto;padding-top:8px;display:flex;flex-wrap:wrap;gap:4px;">
                {eraConcepts.slice(0, 3).map((c) => (
                  <span class="at-mono" style="font-size:0.67rem;padding:1px 5px;background:var(--bg-canvas);border:1px solid var(--border-subtle);border-radius:3px;">
                    {c[lang].shortName}
                  </span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Surging 2026 Concepts -->
  <section class="at-section">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <div class="at-kicker" style="color:var(--accent-signal);">▲ SURGING MOMENTUM</div>
          <h2>{t.surgingHeading}</h2>
        </div>
        <a href={withBase(`/${lang}/timeline/`)} class="at-mono" style="color:var(--accent-primary);font-size:0.86rem;font-weight:600;">
          {lang === "zh" ? "查看全部 22 个概念演进脉络 →" : "View all 22 concepts →"}
        </a>
      </div>

      <div class="at-concept-list">
        {surgingConcepts.map((c) => (
          <ConceptTimelineCard concept={c} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Flagship Cuts -->
  <section class="at-section">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <div class="at-kicker">SCREENING GALLERY</div>
          <h2>{t.flagshipHeading}</h2>
        </div>
        <a href={withBase(`/${lang}/directory/`)} class="at-mono" style="color:var(--accent-primary);font-size:0.86rem;font-weight:600;">
          {t.ctaDirectory} →
        </a>
      </div>

      <div class="at-grid-cards">
        {featuredNodes.map((n) => n && <MediaCard node={n} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- 4-Stage Learning Roadmap & Topic Hubs -->
  <section class="at-section" style="border-bottom:0;">
    <div class="at-container">
      <div class="at-section-head">
        <div>
          <div class="at-kicker">STRUCTURED PROGRESSION</div>
          <h2>{t.roadmapHeading}</h2>
        </div>
        <a href={withBase(`/${lang}/roadmap/`)} class="at-mono" style="color:var(--accent-primary);font-size:0.86rem;font-weight:600;">
          {lang === "zh" ? "打开完整四阶路线 →" : "Open full 4-stage roadmap →"}
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-bottom:34px;">
        {STAGES.map((st) => {
          const cnt = SPINE_NODES.filter((n) => n.stageId === st.id).length;
          return (
            <a href={withBase(`/${lang}/roadmap/#${st.id}`)} class="at-era-card">
              <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.74rem;color:var(--accent-primary);">
                <span>{st[lang].code}</span>
                <span>{cnt} {lang === "zh" ? "必修精切" : "spine cuts"}</span>
              </div>
              <h3 style="font-size:1.14rem;">{st[lang].title}</h3>
              <p style="font-size:0.84rem;color:var(--ink-secondary);">{st[lang].summary}</p>
            </a>
          );
        })}
      </div>

      <div style="padding-top:22px;border-top:1px solid var(--border-subtle);">
        <div class="at-kicker" style="margin-bottom:10px;">
          {lang === "zh" ? "按专题分面直达（20 个细分专题页）" : "Browse by Topic Hubs (20 Curated Facets)"}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {TAXONOMY_DIMS.flatMap((dim) =>
            dim.items.map((item) => (
              <a href={withBase(`/${lang}/topics/${dim.key}/${item.slug}/`)} class="at-lineage-pill">
                {item[lang].name}
              </a>
            ))
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
