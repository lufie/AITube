---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ScreeningStage from "../../../components/ScreeningStage.astro";
import SliceTimeline from "../../../components/SliceTimeline.astro";
import InlineOpsText from "../../../components/InlineOpsText.astro";
import MediaCard from "../../../components/MediaCard.astro";
import {
  DIFFICULTY_META,
  LANGS,
  UI,
  formatSliceMinutes,
  formatTime,
  withBase,
  type Lang,
} from "../../../lib/i18n";
import {
  NODES,
  getAdjacentNodes,
  getConcept,
  getNode,
  getNodesForConcept,
} from "../../../lib/content";
import { buildNodeSchema } from "../../../lib/seo";
import {
  DONATE_COPY,
  DONATE_DEFAULT_AMOUNT,
  DONATE_PRESETS,
  formatWatchDonateStory,
} from "../../../lib/donate";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    NODES.map((n) => ({
      params: { lang, slug: n.slug },
    }))
  );
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const node = getNode(slug)!;
const loc = node[lang];
const s = node.source;
const t = UI[lang];
const d = DONATE_COPY[lang];
const donateStory = formatWatchDonateStory(lang, s.videosReviewedCount, s.hoursSaved);

const concept = getConcept(node.primaryConcept);
const related = getNodesForConcept(node.primaryConcept)
  .filter((n) => n.slug !== node.slug)
  .slice(0, 3);
const adj = getAdjacentNodes(node.slug);

const pathname = `/${lang}/nodes/${node.slug}/`;
const ogImg = concept ? `/og/concepts/${concept.slug}.png` : `/og/home-${lang}.png`;
const schema = buildNodeSchema(node, concept, lang, pathname);

const windowSpec =
  s.kind === "video-cut"
    ? `${formatTime(s.startSec || 0)}–${formatTime(s.endSec || 0)} · ${formatSliceMinutes(s.startSec || 0, s.endSec || 60, lang)}`
    : lang === "zh"
      ? `约 ${s.readingMinutes || 10} 分钟阅读`
      : `${s.readingMinutes || 10} min read`;

const start = s.startSec || 0;
const end = s.endSec || 60;
const stepTimes = [
  start,
  Math.round(start + (end - start) * 0.36),
  Math.round(start + (end - start) * 0.72),
];
const isYoutubeCut = s.kind === "video-cut" && s.platform === "youtube" && Boolean(s.videoId);
---
<BaseLayout
  title={`${loc.title} — AITube`}
  description={`${loc.whyWatch} ${loc.subtitle}`}
  lang={lang}
  pathname={pathname}
  ogImage={ogImg}
  schema={schema}
>
  <div class="at-container">
    <article class="at-watch-shell">
      <!-- Quiet Breadcrumb -->
      <nav style="font-size:0.82rem;color:var(--ink-muted);margin-bottom:16px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
        <a href={withBase(`/${lang}/directory/`)}>{t.navDirectory}</a>
        <span>/</span>
        {concept && (
          <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} style="color:var(--accent-primary);">
            {concept[lang].shortName}
          </a>
        )}
      </nav>

      <!-- Cinema-First Stage (WWDC Style) -->
      <section id="stage">
        <ScreeningStage node={node} lang={lang} />
        <SliceTimeline node={node} lang={lang} />
      </section>

      <!-- Clean Title & One-Line Metadata Below Player -->
      <header class="at-watch-header">
        <div style="max-width:68ch;">
          <h1 style="font-size:clamp(1.45rem,2.4vw,1.95rem);line-height:1.28;">{loc.title}</h1>
          <p style="margin-top:8px;font-size:0.96rem;color:var(--ink-secondary);line-height:1.55;">
            {loc.subtitle}
          </p>
          <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;font-size:0.83rem;color:var(--ink-muted);">
            <span style="color:var(--ink-primary);font-weight:560;">{s.channelName}</span>
            <span>·</span>
            <span class="at-mono">{windowSpec}</span>
            <span>·</span>
            <span>{DIFFICULTY_META[node.facets.difficulty]?.[lang] || node.facets.difficulty}</span>
          </div>
        </div>

        <button
          type="button"
          class="at-btn-ghost"
          style="flex-shrink:0;"
          data-toggle-read={node.slug}
          data-label-unread={t.markRead}
          data-label-read={t.markedRead}
        >
          {t.markRead}
        </button>
      </header>

      <!-- Clean 2-Column Takeaways + Practical Side Card -->
      <div class="at-watch-notes">
        <section aria-label="Key takeaways">
          <h2 style="font-size:1.12rem;margin-bottom:8px;">
            {lang === "zh" ? "核心要点" : "Key Takeaways"}
          </h2>

          <div>
            {loc.steps.map((st, idx) => (
              <div class="at-takeaway-item">
                <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:6px;">
                  <h3 style="font-size:0.98rem;font-weight:620;">
                    <span class="at-mono" style="color:var(--ink-muted);margin-right:8px;">0{idx + 1}</span>
                    <InlineOpsText text={st.title} />
                  </h3>
                  {isYoutubeCut && (
                    <button
                      type="button"
                      class="at-chip at-mono"
                      data-seek-sec={stepTimes[idx]}
                      style="font-size:0.74rem;padding:3px 10px;flex-shrink:0;"
                    >
                      ▶ {formatTime(stepTimes[idx])}
                    </button>
                  )}
                </div>
                <p style="color:var(--ink-secondary);font-size:0.92rem;line-height:1.6;">
                  <InlineOpsText text={st.detail} />
                </p>
              </div>
            ))}
          </div>

          <!-- Peak-Gratitude Inline Coffee Strip right below Takeaway #03 -->
          <div class="at-takeaway-coffee-bar">
            <span class="at-takeaway-coffee-text">{d.takeawayPrompt}</span>
            <div class="at-takeaway-coffee-actions">
              <button
                type="button"
                class="at-coffee-chip-primary"
                data-open-donate
                data-donate-amount={DONATE_DEFAULT_AMOUNT}
                data-donate-context={`${node.slug}-takeaway`}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                  <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
                  <line x1="6" x2="6" y1="2" y2="4" />
                  <line x1="10" x2="10" y1="2" y2="4" />
                  <line x1="14" x2="14" y1="2" y2="4" />
                </svg>
                <span>{d.takeawayCoffeeBtn}</span>
              </button>
              <button
                type="button"
                class="at-coffee-chip-ghost"
                data-open-donate
                data-donate-amount="custom"
                data-donate-context={`${node.slug}-takeaway`}
              >
                {d.takeawayCustomBtn}
              </button>
            </div>
          </div>
        </section>

        <aside class="at-side-card" data-chk-slug={node.slug}>
          <div>
            <div style="font-size:0.78rem;font-weight:650;color:var(--accent-signal);margin-bottom:6px;">
              {t.versionPatchTitle}
            </div>
            <p style="font-size:0.88rem;color:var(--ink-secondary);line-height:1.58;">
              <InlineOpsText text={loc.versionPatch} />
            </p>
          </div>

          <div style="margin-top:20px;padding-top:18px;border-top:1px solid var(--border-subtle);">
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px;">
              <span style="font-size:0.84rem;font-weight:620;">{t.checklistTitle}</span>
              <span class="at-mono" id="at-chk-progress" style="font-size:0.76rem;color:var(--ink-muted);">
                0/{loc.checklist.length}
              </span>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;">
              {loc.checklist.map((item, idx) => (
                <label style="display:flex;gap:9px;align-items:baseline;cursor:pointer;font-size:0.86rem;color:var(--ink-secondary);">
                  <input type="checkbox" data-chk-idx={idx} style="accent-color:var(--accent-primary);" />
                  <span><InlineOpsText text={item} /></span>
                </label>
              ))}
            </div>
          </div>

          {loc.tools.length > 0 && (
            <div style="margin-top:20px;padding-top:18px;border-top:1px solid var(--border-subtle);">
              <div style="font-size:0.78rem;font-weight:600;color:var(--ink-muted);margin-bottom:8px;">
                {t.toolsTitle}
              </div>
              <div style="display:flex;flex-direction:column;gap:8px;">
                {loc.tools.map((tl) => (
                  <a
                    href={tl.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display:block;padding:10px 12px;border-radius:10px;background:var(--bg-canvas);font-size:0.84rem;"
                  >
                    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;">
                      <strong style="font-weight:600;">{tl.name}</strong>
                      <span style="font-size:0.75rem;color:var(--accent-primary);">↗</span>
                    </div>
                    <div style="font-size:0.78rem;color:var(--ink-muted);margin-top:2px;">{tl.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Coffee-First Donate Card with Dynamic Curation Effort Story -->
          <div class="at-watch-donate">
            <span class="at-watch-donate-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
              </svg>
              <span>{d.watchBadge}</span>
            </span>
            <h3 style="font-size:0.93rem;font-weight:650;line-height:1.4;margin-bottom:6px;">
              {d.watchTitle}
            </h3>
            <p style="font-size:0.8rem;color:var(--ink-secondary);line-height:1.58;">
              {donateStory}
            </p>
            <div class="at-watch-donate-pills">
              {DONATE_PRESETS.map((amt) => (
                <button
                  type="button"
                  class={`at-watch-tier-pill at-mono ${amt === DONATE_DEFAULT_AMOUNT ? "is-popular" : ""}`}
                  data-open-donate
                  data-donate-amount={amt}
                  data-donate-context={node.slug}
                >
                  ${amt}
                </button>
              ))}
              <button
                type="button"
                class="at-watch-tier-pill"
                data-open-donate
                data-donate-amount="custom"
                data-donate-context={node.slug}
              >
                {d.watchCustom}
              </button>
            </div>
            <button
              type="button"
              class="at-donate-btn"
              style="width:100%;"
              data-open-donate
              data-donate-amount={DONATE_DEFAULT_AMOUNT}
              data-donate-context={node.slug}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
                <line x1="6" x2="6" y1="2" y2="4" />
                <line x1="10" x2="10" y1="2" y2="4" />
                <line x1="14" x2="14" y1="2" y2="4" />
              </svg>
              <span>{d.watchBtn}</span>
            </button>
            <div class="at-watch-donate-reassure">{d.watchReassure}</div>
          </div>
        </aside>
      </div>

      <!-- Related Videos Shelf -->
      {related.length > 0 && (
        <section style="padding-top:32px;border-top:1px solid var(--border-subtle);">
          <div class="at-section-head" style="margin-bottom:20px;">
            <h2 style="font-size:1.25rem;">{t.sameConceptTitle}</h2>
            {concept && (
              <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} class="at-text-link" style="font-size:0.86rem;">
                {lang === "zh" ? `查看「${concept[lang].shortName}」全部视频 ›` : `All in ${concept[lang].shortName} ›`}
              </a>
            )}
          </div>
          <div class="at-grid-cards">
            {related.map((r) => (
              <MediaCard node={r} lang={lang} />
            ))}
          </div>
        </section>
      )}

      <nav
        aria-label="Adjacent videos"
        style="margin-top:40px;padding-top:20px;border-top:1px solid var(--border-subtle);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:0.86rem;"
      >
        {adj.prev ? (
          <a href={withBase(`/${lang}/nodes/${adj.prev.slug}/`)} class="at-text-link">
            ← {adj.prev[lang].title.slice(0, 32)}
          </a>
        ) : (
          <span />
        )}
        {adj.next && (
          <a href={withBase(`/${lang}/nodes/${adj.next.slug}/`)} class="at-text-link">
            {adj.next[lang].title.slice(0, 32)} →
          </a>
        )}
      </nav>
    </article>
  </div>

  <script is:inline>
    (() => {
      const chkBox = document.querySelector("[data-chk-slug]");
      if (!chkBox) return;
      const slug = chkBox.getAttribute("data-chk-slug");
      const inputs = [...chkBox.querySelectorAll("[data-chk-idx]")];
      const prog = document.getElementById("at-chk-progress");
      const key = `aitube-chk-${slug}`;
      let saved = [];
      try {
        saved = JSON.parse(localStorage.getItem(key) || "[]");
      } catch {}

      function syncChk() {
        const checked = inputs.filter((i) => i.checked).map((i) => Number(i.getAttribute("data-chk-idx")));
        if (prog) prog.textContent = `${checked.length}/${inputs.length}`;
        try {
          localStorage.setItem(key, JSON.stringify(checked));
        } catch {}
      }

      inputs.forEach((inp) => {
        const idx = Number(inp.getAttribute("data-chk-idx"));
        if (saved.includes(idx)) inp.checked = true;
        inp.addEventListener("change", syncChk);
      });
      syncChk();
    })();
  </script>
</BaseLayout>
