---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ConceptHorizonMap from "../../../components/ConceptHorizonMap.astro";
import ConceptTimelineCard from "../../../components/ConceptTimelineCard.astro";
import { LANGS, LIFECYCLE_META, UI, withBase, type Lang } from "../../../lib/i18n";
import {
  CONCEPTS,
  ERAS,
  buildSparklineGeometry,
  getNodesForConcept,
  splitParadigmShift,
} from "../../../lib/content";
import { CONCEPT_AUDIENCE } from "../../../lib/personas";
import { absUrl, buildBreadcrumbSchema, orgAndSiteGraph } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = UI[lang];

const focusPresets =
  lang === "zh"
    ? [
        { id: "all", label: `全部 (${CONCEPTS.length})` },
        { id: "surging", label: "今年最火 (6)" },
        { id: "beginner", label: "小白必懂 (5)" },
        { id: "applied", label: "日常应用 (6)" },
        { id: "career", label: "开发基本功 (5)" },
        { id: "evolved", label: "已有新做法 (4)" },
      ]
    : [
        { id: "all", label: `All (${CONCEPTS.length})` },
        { id: "surging", label: "Trending in 2026 (6)" },
        { id: "beginner", label: "Beginner Basics (5)" },
        { id: "applied", label: "Everyday Work (6)" },
        { id: "career", label: "Core Engineering (5)" },
        { id: "evolved", label: "Updated Habits (4)" },
      ];

const title =
  lang === "zh"
    ? "AI 概念时间线（2017–2026）— AITube"
    : "AI Concept Timeline (2017–2026) — AITube";
const desc =
  lang === "zh"
    ? "按时间顺序梳理 2017–2026 年最核心的 22 个 AI 概念，一眼看清每个新词解决什么问题、怎么一步步演变。"
    : "Trace 22 core AI concepts from 2017 to 2026 — see when each idea broke out and what changed in plain language.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    ...orgAndSiteGraph(lang),
    buildBreadcrumbSchema([
      { name: "AITube", path: `/${lang}/` },
      { name: t.navTimeline, path: `/${lang}/timeline/` },
    ]),
    {
      "@type": "DefinedTermSet",
      "@id": absUrl(`/${lang}/timeline/`),
      name: title,
      description: desc,
      hasDefinedTerm: CONCEPTS.map((c) => ({
        "@type": "DefinedTerm",
        name: c[lang].name,
        termCode: c.slug,
        url: absUrl(`/${lang}/concepts/${c.slug}/`),
      })),
    },
  ],
};
---
<BaseLayout
  title={title}
  description={desc}
  lang={lang}
  pathname={`/${lang}/timeline/`}
  ogImage={`/og/timeline-${lang}.png`}
  schema={schema}
>
  <section class="at-page-header" style="padding-bottom:24px;">
    <div class="at-container">
      <div style="max-width:68ch;">
        <h1 class="at-page-h1">
          {lang === "zh" ? "AI 概念时间线" : "AI Concept Timeline"}
        </h1>
        <p class="at-page-lead">{desc}</p>
      </div>

      <ConceptHorizonMap lang={lang} mode="timeline" />
    </div>
  </section>

  <!-- Single Clean Sticky Filter & View Bar (Replaces 20+ Duplicate Controls) -->
  <div class="at-timeline-toolbar">
    <div class="at-container" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
      <div class="at-filter-row" role="group" aria-label="Focus lens">
        {focusPresets.map((pr, idx) => (
          <button
            type="button"
            class={`at-chip ${idx === 0 ? "is-active" : ""}`}
            data-tl-preset={pr.id}
          >
            {pr.label}
          </button>
        ))}
      </div>

      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <input
          type="search"
          id="tl-search"
          class="at-glass-input"
          placeholder={lang === "zh" ? "搜概念…" : "Filter topics..."}
          style="width:176px;padding:6px 14px;font-size:0.83rem;"
        />
        <div class="at-segmented" data-liquid-seg role="group" aria-label="View mode" style="padding:3px;">
          <button type="button" class="at-seg-btn is-active" data-tl-view="editorial" style="padding:4px 12px;font-size:0.8rem;">
            {t.editorialView}
          </button>
          <button type="button" class="at-seg-btn" data-tl-view="matrix" style="padding:4px 12px;font-size:0.8rem;">
            {t.matrixView}
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="at-container" style="padding-bottom:68px;">
    <div class="at-tl-workspace" id="tl-editorial-view">
      <aside class="at-era-rail" aria-label="Era navigation">
        {ERAS.map((era, idx) => (
          <a href={`#${era.id}`} class={`at-era-rail-link ${idx === 0 ? "is-current" : ""}`} data-era-spy={era.id}>
            <div class="at-mono" style="font-size:0.72rem;color:var(--ink-muted);">{era.period}</div>
            <div>{era[lang].title}</div>
          </a>
        ))}
      </aside>

      <div>
        {ERAS.map((era) => {
          const eraConcepts = CONCEPTS.filter((c) => c.eraId === era.id);
          return (
            <section class="at-era-block" id={era.id} data-era-section={era.id}>
              <div class="at-era-header">
                <div class="at-kicker" style="margin-bottom:4px;">{era.period}</div>
                <h2 style="font-size:1.5rem;">{era[lang].title}</h2>
                <p style="margin-top:4px;max-width:60ch;font-size:0.92rem;color:var(--ink-secondary);">
                  {era[lang].subtitle}
                </p>
              </div>

              <div class="at-concept-list">
                {eraConcepts.map((c) => (
                  <ConceptTimelineCard concept={c} lang={lang} />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>

    <!-- Clean One-Table Overview -->
    <div class="at-matrix-wrap" id="tl-matrix-view" style="display:none;">
      <table class="at-matrix-table">
        <thead>
          <tr>
            <th>{lang === "zh" ? "概念" : "Topic"}</th>
            <th>{lang === "zh" ? "爆发时间" : "Breakout"}</th>
            <th>{lang === "zh" ? "现在做法" : "Current Practice"}</th>
            <th>{lang === "zh" ? "近四年热度" : "Trend"}</th>
            <th>{lang === "zh" ? "视频" : "Videos"}</th>
          </tr>
        </thead>
        <tbody>
          {CONCEPTS.map((c) => {
            const loc = c[lang];
            const lf = LIFECYCLE_META[c.lifecycle];
            const aud = CONCEPT_AUDIENCE[c.slug] || { role: "career" };
            const sh = splitParadigmShift(loc.paradigmShift);
            const sp = buildSparklineGeometry(c.trendSeries, 104, 26, 3);
            const cnt = getNodesForConcept(c.slug).length;
            return (
              <tr
                data-matrix-row
                data-concept-slug={c.slug}
                data-era={c.eraId}
                data-lifecycle={c.lifecycle}
                data-domain={c.domain}
                data-audience={aud.role}
                data-search={`${c.en.name} ${c.zh.name} ${loc.oneLiner} ${loc.paradigmShift}`.toLowerCase()}
              >
                <td>
                  <a href={withBase(`/${lang}/concepts/${c.slug}/`)} style="font-weight:600;color:var(--ink-primary);">
                    {loc.shortName}
                  </a>
                  <div style="margin-top:3px;">
                    <span class={`at-life at-life-${c.lifecycle}`}>{lf[lang]}</span>
                  </div>
                </td>
                <td class="at-mono" style="white-space:nowrap;color:var(--ink-secondary);">
                  {c.inflectionQuarter}
                </td>
                <td style="max-width:360px;font-size:0.84rem;color:var(--ink-secondary);">
                  {sh.after}
                </td>
                <td>
                  <svg width="104" height="26" viewBox="0 0 104 26" aria-hidden="true">
                    <path d={sp.areaPath} fill="var(--accent-primary-soft)" />
                    <path d={sp.path} fill="none" stroke="var(--accent-primary)" stroke-width="1.8" />
                  </svg>
                </td>
                <td class="at-mono">
                  <a href={withBase(`/${lang}/concepts/${c.slug}/`)} class="at-text-link" style="font-size:0.82rem;">
                    {cnt} ›
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    (() => {
      let activePreset = "all";
      let query = "";
      let viewMode = "editorial";

      const cards = [...document.querySelectorAll("[data-concept-card]")];
      const matrixRows = [...document.querySelectorAll("[data-matrix-row]")];
      const hzNodes = [...document.querySelectorAll("#hz-timeline [data-hz-slug]")];
      const sections = [...document.querySelectorAll("[data-era-section]")];
      const railLinks = [...document.querySelectorAll("[data-era-spy]")];
      const searchInput = document.getElementById("tl-search");
      const edView = document.getElementById("tl-editorial-view");
      const mxView = document.getElementById("tl-matrix-view");

      function matchesItem(el) {
        const elLife = el.getAttribute("data-lifecycle");
        const elAud = el.getAttribute("data-audience");
        const s = el.getAttribute("data-search") || "";

        if (activePreset === "surging" && elLife !== "surging") return false;
        if (activePreset === "evolved" && elLife !== "evolved") return false;
        if ((activePreset === "beginner" || activePreset === "applied" || activePreset === "career") && elAud !== activePreset) {
          return false;
        }
        if (query && !s.includes(query)) return false;
        return true;
      }

      function apply() {
        const visibleSlugs = new Set();
        cards.forEach((card) => {
          const ok = matchesItem(card);
          card.style.display = ok ? "" : "none";
          if (ok) visibleSlugs.add(card.getAttribute("data-concept-slug"));
        });
        matrixRows.forEach((row) => {
          row.style.display = matchesItem(row) ? "" : "none";
        });
        hzNodes.forEach((nd) => {
          const slug = nd.getAttribute("data-hz-slug");
          nd.classList.toggle("is-filtered-out", !visibleSlugs.has(slug));
        });
        sections.forEach((sec) => {
          const anyVisible = [...sec.querySelectorAll("[data-concept-card]")].some((c) => c.style.display !== "none");
          sec.style.display = anyVisible ? "" : "none";
        });
      }

      function pulseContainer(el) {
        if (!el) return;
        el.classList.remove("at-grid-refreshing");
        void el.offsetWidth;
        el.classList.add("at-grid-refreshing");
      }

      function activatePreset(pid, animate) {
        activePreset = pid;
        document.querySelectorAll("[data-tl-preset]").forEach((b) => {
          b.classList.toggle("is-active", b.getAttribute("data-tl-preset") === pid);
        });
        apply();
        if (animate) pulseContainer(viewMode === "matrix" ? mxView : edView);
      }

      function setView(mode, animate) {
        viewMode = mode === "matrix" ? "matrix" : "editorial";
        document.querySelectorAll("[data-tl-view]").forEach((b) => {
          b.classList.toggle("is-active", b.getAttribute("data-tl-view") === viewMode);
        });
        if (window.__syncLiquidSegs) window.__syncLiquidSegs();
        if (edView && mxView) {
          edView.style.display = viewMode === "editorial" ? "" : "none";
          mxView.style.display = viewMode === "matrix" ? "" : "none";
          if (animate) pulseContainer(viewMode === "matrix" ? mxView : edView);
        }
      }

      document.querySelectorAll("[data-tl-preset]").forEach((btn) => {
        btn.addEventListener("click", () => {
          activatePreset(btn.getAttribute("data-tl-preset") || "all", true);
        });
      });

      document.querySelectorAll("[data-tl-view]").forEach((btn) => {
        btn.addEventListener("click", () => {
          setView(btn.getAttribute("data-tl-view") || "editorial", true);
        });
      });

      let tlSearchTimer = 0;
      searchInput?.addEventListener("input", () => {
        clearTimeout(tlSearchTimer);
        tlSearchTimer = setTimeout(() => {
          query = searchInput.value.trim().toLowerCase();
          apply();
        }, 90);
      });

      cards.forEach((card) => {
        const slug = card.getAttribute("data-concept-slug");
        card.addEventListener("mouseenter", () => {
          const hook = window.__syncHorizon_hz_timeline || window["__syncHorizon_hz-timeline"];
          if (hook && typeof hook.focusConcept === "function") hook.focusConcept(slug);
        });
      });

      if ("IntersectionObserver" in window && sections.length && railLinks.length) {
        const obs = new IntersectionObserver(
          (entries) => {
            const visible = entries.filter((e) => e.isIntersecting);
            if (!visible.length) return;
            const id = visible[0].target.getAttribute("id");
            railLinks.forEach((lk) => {
              lk.classList.toggle("is-current", lk.getAttribute("data-era-spy") === id);
            });
          },
          { rootMargin: "-18% 0px -65% 0px", threshold: 0.05 }
        );
        sections.forEach((s) => obs.observe(s));
      }

      try {
        const sp = new URLSearchParams(window.location.search);
        const qPreset = sp.get("preset");
        const qView = sp.get("view");
        if (qView === "matrix") setView("matrix");
        if (qPreset) activatePreset(qPreset);
      } catch {}
    })();
  </script>
</BaseLayout>
