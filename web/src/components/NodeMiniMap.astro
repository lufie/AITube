---
import type { Concept } from "../lib/content";
import { UI, withBase, type Lang } from "../lib/i18n";

interface Props {
  concept?: Concept;
  lang: Lang;
  slug: string;
}
const { concept, lang, slug } = Astro.props;
const t = UI[lang];
---
<aside class="at-minimap" aria-label="Section map">
  {concept && (
    <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} class="at-kicker" style="margin-bottom:6px;padding-left:8px;">
      ← {concept[lang].shortName}
    </a>
  )}
  <a href="#stage" class="at-minimap-link is-active" data-spy-link="stage">01 · {lang === "zh" ? "看核心片段" : "Watch Highlight"}</a>
  <a href="#steps" class="at-minimap-link" data-spy-link="steps">02 · {lang === "zh" ? "三步看懂重点" : "3 Key Takeaways"}</a>
  <a href="#patch" class="at-minimap-link" data-spy-link="patch">03 · {lang === "zh" ? "2026 新变化" : "What's New"}</a>
  <a href="#checklist" class="at-minimap-link" data-spy-link="checklist">04 · {lang === "zh" ? "顺手试一下" : "Quick Try"}</a>
  <a href="#related" class="at-minimap-link" data-spy-link="related">05 · {lang === "zh" ? "同类好视频" : "Related Videos"}</a>

  <button
    type="button"
    class="at-btn-ghost"
    style="margin-top:10px;font-size:0.78rem;padding:7px 10px;justify-content:center;"
    data-toggle-read={slug}
    data-label-unread={t.markRead}
    data-label-read={t.markedRead}
  >
    {t.markRead}
  </button>
</aside>
