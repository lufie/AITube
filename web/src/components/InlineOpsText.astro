---
import { tokenizeInlineOps } from "../lib/content";

interface Props {
  text: string;
}
const { text } = Astro.props;
const tokens = tokenizeInlineOps(text);
---
{tokens.map((tok) =>
  tok.type === "op" ? (
    <button type="button" class="at-op-chip" data-copy-op={tok.value} title="Click to copy">
      <span>{tok.value}</span>
      <span aria-hidden="true" style="opacity:0.65;font-size:0.75em;">⧉</span>
    </button>
  ) : (
    tok.value
  )
)}
