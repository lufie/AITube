---
import { tokenizeInlineOps } from "../lib/content";

interface Props {
  text: string;
}
const { text } = Astro.props;
const tokens = tokenizeInlineOps(text);
---
{tokens.map((tok) =>
  tok.type === "op" ? (
    <button type="button" class="at-op-chip" data-copy-op={tok.value} title="Click to copy">
      <span>{tok.value}</span>
      <svg aria-hidden="true" width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.65;flex-shrink:0;">
        <rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1.5" />
        <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
      </svg>
    </button>
  ) : (
    tok.value
  )
)}
