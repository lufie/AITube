---
import {
  SERIES_LABELS,
  buildSparklineGeometry,
  getConcept,
  getNodesForConcept,
  getRepresentativeConceptCuts,
  splitParadigmShift,
  type Concept,
} from "../lib/content";
import { LIFECYCLE_META, ROLE_META, UI, formatTime, withBase, type Lang } from "../lib/i18n";
import { CONCEPT_AUDIENCE } from "../lib/personas";

interface Props {
  concept: Concept;
  lang: Lang;
}
const { concept, lang } = Astro.props;
const loc = concept[lang];
const t = UI[lang];
const life = LIFECYCLE_META[concept.lifecycle];
const aud = CONCEPT_AUDIENCE[concept.slug] || {
  role: "career",
  zhBadge: "🧭 转行必学基本功",
  enBadge: "🧭 Core Dev Skill",
};
const spark = buildSparklineGeometry(concept.trendSeries, 202, 50, 6);
const inflectPt = spark.points[concept.inflectionIndex] || spark.points[spark.points.length - 1];
const shift = splitParadigmShift(loc.paradigmShift);
const allNodes = getNodesForConcept(concept.slug);
const repCuts = getRepresentativeConceptCuts(concept.slug, 3);
---
<article
  class="at-concept-card"
  id={`concept-${concept.slug}`}
  data-concept-card
  data-concept-slug={concept.slug}
  data-era={concept.eraId}
  data-lifecycle={concept.lifecycle}
  data-domain={concept.domain}
  data-audience={aud.role}
  data-search={`${concept.en.name} ${concept.zh.name} ${loc.oneLiner} ${loc.paradigmShift}`.toLowerCase()}
>
  <div class="at-concept-top">
    <div>
      <div class="at-concept-meta">
        <span class="at-mono" style="font-size:0.75rem;color:var(--ink-muted);">#{String(concept.order).padStart(2, "0")}</span>
        <span class="at-audience-pill" data-aud-role={aud.role}>
          {lang === "zh" ? aud.zhBadge : aud.enBadge}
        </span>
        <span class="at-mono" style="font-size:0.75rem;padding:2px 8px;background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:3px;">
          {concept.originQuarter} → <strong style="color:var(--accent-signal);">★ {concept.inflectionQuarter}</strong>
        </span>
        <span class={`at-life at-life-${concept.lifecycle}`}>
          <span>{life.icon}</span>
          <span>{life[lang]}</span>
        </span>
      </div>

      <h3 style="font-size:1.36rem;margin-bottom:6px;">
        <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} style="border-bottom:1px solid transparent;">
          {loc.name}
        </a>
      </h3>
      <p style="color:var(--ink-secondary);font-size:0.93rem;line-height:1.58;">{loc.oneLiner}</p>
    </div>

    <div
      class="at-spark-box"
      data-spark-box
      data-pts={JSON.stringify(spark.points)}
      data-labels={JSON.stringify(SERIES_LABELS)}
      data-default-mom={concept.momentum}
      data-inflect-idx={concept.inflectionIndex}
    >
      <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.68rem;color:var(--ink-muted);margin-bottom:3px;">
        <span data-sp-left>22H2</span>
        <span data-sp-mid style="color:var(--accent-primary);font-weight:600;">{concept.momentum}</span>
        <span data-sp-right>26Q3</span>
      </div>
      <svg
        width="202"
        height="50"
        viewBox="0 0 202 50"
        style="display:block;width:100%;height:auto;cursor:crosshair;"
        role="img"
        aria-label={`${loc.shortName} trend`}
        data-spark-svg
      >
        <line x1="6" y1="25" x2="196" y2="25" stroke="var(--border-subtle)" stroke-width="1" stroke-dasharray="2 2" />
        <path d={spark.areaPath} fill="var(--accent-primary-soft)" />
        <path
          d={spark.path}
          fill="none"
          stroke="var(--accent-primary)"
          stroke-width="2.3"
          stroke-linecap="round"
        />
        <line
          data-sp-guide
          x1={inflectPt.x}
          y1="4"
          x2={inflectPt.x}
          y2="46"
          stroke="var(--accent-signal)"
          stroke-width="1"
          stroke-dasharray="2 2"
          opacity="0.45"
        />
        <circle
          data-sp-dot
          cx={inflectPt.x}
          cy={inflectPt.y}
          r="4.3"
          fill="var(--accent-signal)"
          stroke="var(--bg-canvas)"
          stroke-width="1.4"
        />
      </svg>
    </div>
  </div>

  <!-- Architectural Before -> After Paradigm Shift Split -->
  {shift.before ? (
    <div class="at-shift-split">
      <div class="at-shift-col-before">
        <div class="at-mono" style="font-size:0.66rem;letter-spacing:0.06em;margin-bottom:2px;">{t.beforeLabel}</div>
        <div style="text-decoration:line-through;opacity:0.88;">{shift.before}</div>
      </div>
      <div class="at-mono" style="display:flex;align-items:center;color:var(--accent-signal);font-weight:700;font-size:0.95rem;">
        →
      </div>
      <div class="at-shift-col-after">
        <div class="at-mono" style="font-size:0.66rem;letter-spacing:0.06em;color:var(--accent-primary);margin-bottom:2px;">
          {t.afterLabel}
        </div>
        <div>{shift.after}</div>
      </div>
    </div>
  ) : (
    <div class="at-shift-split" style="grid-template-columns:1fr;">
      <div class="at-shift-col-after" style="border-left:0;padding-left:0;">{shift.after}</div>
    </div>
  )}

  {(concept.lineage.from.length > 0 || concept.lineage.into.length > 0) && (
    <div class="at-lineage-row">
      {concept.lineage.from.length > 0 && (
        <>
          <span>{t.lineageFrom}:</span>
          {concept.lineage.from.map((slug) => {
            const up = getConcept(slug);
            return up ? (
              <a href={withBase(`/${lang}/concepts/${up.slug}/`)} class="at-lineage-pill">
                ↖ {up[lang].shortName}
              </a>
            ) : null;
          })}
        </>
      )}
      {concept.lineage.into.length > 0 && (
        <>
          <span style="margin-left:6px;">{t.lineageInto}:</span>
          {concept.lineage.into.map((slug) => {
            const down = getConcept(slug);
            return down ? (
              <a href={withBase(`/${lang}/concepts/${down.slug}/`)} class="at-lineage-pill">
                ↘ {down[lang].shortName}
              </a>
            ) : null;
          })}
        </>
      )}
    </div>
  )}

  <!-- 3 Filmstrip Micro-Thumbnail Representative Cuts -->
  <div class="at-mini-cuts">
    {repCuts.map((cut, rIdx) => {
      const s = cut.source;
      const win =
        s.kind === "video-cut"
          ? `${formatTime(s.startSec || 0)}–${formatTime(s.endSec || 0)}`
          : `${s.readingMinutes || 10}m`;
      const ytThumb = s.platform === "youtube" && s.videoId ? `https://i.ytimg.com/vi/${s.videoId}/hqdefault.jpg` : null;
      return (
        <a href={withBase(`/${lang}/nodes/${cut.slug}/`)} class="at-mini-cut">
          <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.68rem;color:var(--accent-primary);">
            <span>0{rIdx + 1} · {ROLE_META[cut.conceptRole][lang]}</span>
            <span>{win}</span>
          </div>
          <div class="at-mini-film">
            <div class="at-mini-thumb" aria-hidden="true">
              {ytThumb ? (
                <>
                  <img src={ytThumb} alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
                  <span class="at-mini-thumb-play">▶</span>
                </>
              ) : (
                <span>{s.kind === "article-digest" ? (lang === "zh" ? "好文" : "DOC") : (lang === "zh" ? "B站" : "BILI")}</span>
              )}
            </div>
            <div style="min-width:0;flex:1;">
              <div style="font-weight:560;line-height:1.34;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                {cut[lang].title}
              </div>
              <div style="font-size:0.72rem;color:var(--ink-muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                {s.channelName}
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:0.82rem;flex-wrap:wrap;">
    <span style="color:var(--ink-muted);flex:1;min-width:220px;">{loc.whyNow}</span>
    <a
      href={withBase(`/${lang}/concepts/${concept.slug}/`)}
      class="at-mono"
      style="color:var(--accent-primary);font-weight:600;white-space:nowrap;"
    >
      {t.viewConceptHub} ({allNodes.length}) →
    </a>
  </div>
</article>
