---
import {
  buildSparklineGeometry,
  getConcept,
  getNodesForConcept,
  getRepresentativeConceptCuts,
  splitParadigmShift,
  type Concept,
} from "../lib/content";
import { LIFECYCLE_META, ROLE_META, UI, formatTime, withBase, type Lang } from "../lib/i18n";

interface Props {
  concept: Concept;
  lang: Lang;
}
const { concept, lang } = Astro.props;
const loc = concept[lang];
const t = UI[lang];
const life = LIFECYCLE_META[concept.lifecycle];
const spark = buildSparklineGeometry(concept.trendSeries, 184, 46, 5);
const inflectPt = spark.points[concept.inflectionIndex] || spark.points[spark.points.length - 1];
const shift = splitParadigmShift(loc.paradigmShift);
const allNodes = getNodesForConcept(concept.slug);
const repCuts = getRepresentativeConceptCuts(concept.slug, 3);
---
<article
  class="at-concept-card"
  id={`concept-${concept.slug}`}
  data-concept-card
  data-era={concept.eraId}
  data-lifecycle={concept.lifecycle}
  data-domain={concept.domain}
  data-search={`${concept.en.name} ${concept.zh.name} ${loc.oneLiner} ${loc.paradigmShift}`.toLowerCase()}
>
  <div class="at-concept-top">
    <div>
      <div class="at-concept-meta">
        <span class="at-mono" style="font-size:0.75rem;color:var(--ink-muted);">#{String(concept.order).padStart(2, "0")}</span>
        <span class="at-mono" style="font-size:0.75rem;padding:2px 7px;background:var(--bg-elevated);border:1px solid var(--border-subtle);border-radius:3px;">
          {concept.originQuarter} → <strong style="color:var(--accent-signal);">{concept.inflectionQuarter}</strong>
        </span>
        <span class={`at-life at-life-${concept.lifecycle}`}>
          <span>{life.icon}</span>
          <span>{life[lang]}</span>
        </span>
      </div>

      <h3 style="font-size:1.34rem;margin-bottom:6px;">
        <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} style="border-bottom:1px solid transparent;">
          {loc.name}
        </a>
      </h3>
      <p style="color:var(--ink-secondary);font-size:0.93rem;">{loc.oneLiner}</p>
    </div>

    <div class="at-spark-box">
      <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.67rem;color:var(--ink-muted);margin-bottom:3px;">
        <span>22H2</span>
        <span style="color:var(--accent-primary);">{concept.momentum}</span>
        <span>26Q3</span>
      </div>
      <svg width="184" height="46" viewBox="0 0 184 46" role="img" aria-label={`${loc.shortName} trend`}>
        <polygon points={spark.area} fill="var(--accent-primary-soft)" />
        <polyline
          points={spark.polyline}
          fill="none"
          stroke="var(--accent-primary)"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx={inflectPt.x} cy={inflectPt.y} r="4.2" fill="var(--accent-signal)" />
      </svg>
    </div>
  </div>

  <div class="at-shift-bar">
    <span class="at-mono" style="font-size:0.73rem;color:var(--accent-signal);font-weight:600;">{t.paradigmShiftLabel}:</span>
    {shift.before ? (
      <>
        <span style="color:var(--ink-muted);text-decoration:line-through;">{shift.before}</span>
        <span class="at-mono" style="color:var(--accent-primary);">→</span>
        <span style="font-weight:560;">{shift.after}</span>
      </>
    ) : (
      <span>{shift.after}</span>
    )}
  </div>

  {(concept.lineage.from.length > 0 || concept.lineage.into.length > 0) && (
    <div class="at-lineage-row">
      {concept.lineage.from.length > 0 && (
        <>
          <span>{t.lineageFrom}:</span>
          {concept.lineage.from.map((slug) => {
            const up = getConcept(slug);
            return up ? (
              <a href={withBase(`/${lang}/concepts/${up.slug}/`)} class="at-lineage-pill">
                ↖ {up[lang].shortName}
              </a>
            ) : null;
          })}
        </>
      )}
      {concept.lineage.into.length > 0 && (
        <>
          <span style="margin-left:6px;">{t.lineageInto}:</span>
          {concept.lineage.into.map((slug) => {
            const down = getConcept(slug);
            return down ? (
              <a href={withBase(`/${lang}/concepts/${down.slug}/`)} class="at-lineage-pill">
                ↘ {down[lang].shortName}
              </a>
            ) : null;
          })}
        </>
      )}
    </div>
  )}

  <div class="at-mini-cuts">
    {repCuts.map((cut) => {
      const s = cut.source;
      const win =
        s.kind === "video-cut"
          ? `${formatTime(s.startSec || 0)}–${formatTime(s.endSec || 0)}`
          : `${s.readingMinutes || 10}m`;
      return (
        <a href={withBase(`/${lang}/nodes/${cut.slug}/`)} class="at-mini-cut">
          <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.69rem;color:var(--accent-primary);">
            <span>{ROLE_META[cut.conceptRole][lang]}</span>
            <span>{win}</span>
          </div>
          <div style="font-weight:560;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
            {cut[lang].title}
          </div>
          <div style="font-size:0.74rem;color:var(--ink-muted);margin-top:auto;">{s.channelName}</div>
        </a>
      );
    })}
  </div>

  <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;font-size:0.82rem;">
    <span style="color:var(--ink-muted);">{loc.whyNow}</span>
    <a
      href={withBase(`/${lang}/concepts/${concept.slug}/`)}
      class="at-mono"
      style="color:var(--accent-primary);font-weight:600;white-space:nowrap;margin-left:12px;"
    >
      {t.viewConceptHub} ({allNodes.length}) →
    </a>
  </div>
</article>
