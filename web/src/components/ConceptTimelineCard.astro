---
import {
  SERIES_LABELS,
  buildSparklineGeometry,
  getConcept,
  getNodesForConcept,
  getRepresentativeConceptCuts,
  splitParadigmShift,
  type Concept,
} from "../lib/content";
import { LIFECYCLE_META, UI, formatDurationBadge, withBase, type Lang } from "../lib/i18n";
import { CONCEPT_AUDIENCE } from "../lib/personas";

interface Props {
  concept: Concept;
  lang: Lang;
}
const { concept, lang } = Astro.props;
const loc = concept[lang];
const t = UI[lang];
const life = LIFECYCLE_META[concept.lifecycle];
const aud = CONCEPT_AUDIENCE[concept.slug] || {
  role: "career",
  zhBadge: "开发基本功",
  enBadge: "Core Skill",
};
const spark = buildSparklineGeometry(concept.trendSeries, 148, 38, 4);
const inflectPt = spark.points[concept.inflectionIndex] || spark.points[spark.points.length - 1];
const shift = splitParadigmShift(loc.paradigmShift);
const allNodes = getNodesForConcept(concept.slug);
const repCuts = getRepresentativeConceptCuts(concept.slug, 3);
---
<article
  class="at-concept-card"
  id={`concept-${concept.slug}`}
  data-concept-card
  data-concept-slug={concept.slug}
  data-era={concept.eraId}
  data-lifecycle={concept.lifecycle}
  data-domain={concept.domain}
  data-audience={aud.role}
  data-search={`${concept.en.name} ${concept.zh.name} ${loc.oneLiner} ${loc.paradigmShift}`.toLowerCase()}
>
  <div class="at-concept-top">
    <div>
      <div class="at-concept-meta">
        <span class={`at-life at-life-${concept.lifecycle}`}>{life[lang]}</span>
        <span class="at-mono">
          {lang === "zh" ? `${concept.inflectionQuarter} 爆发` : `Breakout ${concept.inflectionQuarter}`}
        </span>
      </div>

      <h3 style="font-size:1.3rem;margin-bottom:6px;">
        <a href={withBase(`/${lang}/concepts/${concept.slug}/`)}>
          {loc.name}
        </a>
      </h3>
      <p style="color:var(--ink-secondary);font-size:0.94rem;line-height:1.58;">{loc.oneLiner}</p>
    </div>

    <div
      class="at-spark-clean"
      data-spark-box
      data-pts={JSON.stringify(spark.points)}
      data-labels={JSON.stringify(SERIES_LABELS)}
      data-default-mom={concept.momentum}
      data-inflect-idx={concept.inflectionIndex}
    >
      <div class="at-mono" style="font-size:0.72rem;color:var(--ink-muted);margin-bottom:2px;">
        <span data-sp-mid style="color:var(--ink-secondary);font-weight:560;">{concept.momentum}</span>
      </div>
      <svg
        width="148"
        height="38"
        viewBox="0 0 148 38"
        style="display:block;margin-left:auto;cursor:crosshair;"
        role="img"
        aria-label={`${loc.shortName} trend`}
        data-spark-svg
      >
        <path d={spark.areaPath} fill="var(--accent-primary-soft)" />
        <path
          d={spark.path}
          fill="none"
          stroke="var(--accent-primary)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <line
          data-sp-guide
          x1={inflectPt.x}
          y1="2"
          x2={inflectPt.x}
          y2="36"
          stroke="var(--accent-signal)"
          stroke-width="1"
          stroke-dasharray="2 2"
          opacity="0.35"
        />
        <circle
          data-sp-dot
          cx={inflectPt.x}
          cy={inflectPt.y}
          r="3.6"
          fill="var(--accent-signal)"
        />
      </svg>
    </div>
  </div>

  <div class="at-shift-bar">
    <strong style="color:var(--ink-primary);font-weight:600;">
      {lang === "zh" ? "现在做法：" : "Now: "}
    </strong>
    <span>{shift.after}</span>
  </div>

  <div class="at-mini-cuts">
    {repCuts.map((cut) => {
      const s = cut.source;
      const dur =
        s.kind === "video-cut"
          ? formatDurationBadge(s.startSec || 0, s.endSec || 60, lang)
          : lang === "zh"
            ? `${s.readingMinutes || 10} 分钟阅读`
            : `${s.readingMinutes || 10} min read`;
      const ytThumb = s.platform === "youtube" && s.videoId ? `https://i.ytimg.com/vi/${s.videoId}/hqdefault.jpg` : null;
      return (
        <a href={withBase(`/${lang}/nodes/${cut.slug}/`)} class="at-mini-cut">
          <div class="at-mini-thumb" aria-hidden="true">
            {ytThumb && (
              <img src={ytThumb} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
            )}
            <span class="at-card-play-glyph" style="width:32px;height:32px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="8 5 19 12 8 19 8 5" />
              </svg>
            </span>
            <span class="at-card-dur" style="bottom:7px;right:7px;font-size:0.69rem;padding:2px 6px;">{dur}</span>
          </div>
          <div class="at-mini-cut-title">{cut[lang].title}</div>
          <div class="at-card-meta" style="font-size:0.76rem;">{s.channelName}</div>
        </a>
      );
    })}
  </div>

  <div style="margin-top:18px;padding-top:14px;border-top:1px solid var(--border-subtle);display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;font-size:0.8rem;color:var(--ink-muted);">
    <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
      {concept.lineage.from.map((slug) => {
        const up = getConcept(slug);
        return up ? (
          <a href={withBase(`/${lang}/concepts/${up.slug}/`)} class="at-lineage-pill">
            {t.lineageFrom}：{up[lang].shortName}
          </a>
        ) : null;
      })}
      {concept.lineage.into.map((slug) => {
        const down = getConcept(slug);
        return down ? (
          <a href={withBase(`/${lang}/concepts/${down.slug}/`)} class="at-lineage-pill">
            {t.lineageInto}：{down[lang].shortName}
          </a>
        ) : null;
      })}
    </div>

    <a href={withBase(`/${lang}/concepts/${concept.slug}/`)} class="at-text-link" style="font-size:0.83rem;">
      {lang === "zh" ? `全部 ${allNodes.length} 支视频 ›` : `All ${allNodes.length} videos ›`}
    </a>
  </div>
</article>
