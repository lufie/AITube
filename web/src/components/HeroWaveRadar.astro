---
import {
  CONCEPTS,
  ERAS,
  NODES,
  SERIES_LABELS,
  SPINE_NODES,
  buildSparklineGeometry,
  getConcept,
  getTotalHoursSaved,
} from "../lib/content";
import { withBase, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const totalHours = getTotalHoursSaved();

const waveDefs = [
  {
    slug: "prompt-cot",
    color: "#6e7b85",
    dashed: true,
    zh: "死背提示词口诀 (2023)",
    en: "Prompt Tricks (2023)",
  },
  {
    slug: "rag-grounding",
    color: "var(--accent-evergreen)",
    dashed: false,
    zh: "外接私有资料库 (2023–24)",
    en: "Private Docs Q&A (2023–24)",
  },
  {
    slug: "mcp-protocol",
    color: "var(--accent-primary)",
    dashed: false,
    zh: "MCP 插头与慢思考 (2025)",
    en: "MCP & Reasoning (2025)",
  },
  {
    slug: "context-engineering",
    color: "var(--accent-signal)",
    dashed: false,
    zh: "整理信息与技能包 (2026)",
    en: "Context & Skills (2026)",
  },
];

const W = 440;
const H = 152;
const PAD = 12;

const waves = waveDefs.map((w) => {
  const c = getConcept(w.slug)!;
  const geom = buildSparklineGeometry(c.trendSeries, W, H, PAD);
  return {
    ...w,
    series: c.trendSeries,
    geom,
    latest: c.trendSeries[c.trendSeries.length - 1],
  };
});

const xCoords = waves[0].geom.points.map((p) => p.x);
---
<div class="at-radar-panel" data-wave-radar>
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;">
    <div>
      <span class="at-kicker" style="font-size:0.68rem;">{lang === "zh" ? "四年热度变化图" : "4-YEAR SHIFT RADAR"}</span>
      <div style="font-family:var(--font-serif);font-size:1.05rem;font-weight:600;">
        {lang === "zh" ? "AI 四波热潮变化图：旧套路退潮，新方法接棒" : "Four Waves of AI Practice (2022–2026)"}
      </div>
    </div>
    <span class="at-mono" data-radar-quarter data-live-suffix={lang === "zh" ? "最新" : "NOW"} style="font-size:0.74rem;color:var(--accent-signal);font-weight:650;">
      26Q3 · {lang === "zh" ? "最新" : "NOW"}
    </span>
  </div>

  <div class="at-radar-legend">
    {waves.map((w, idx) => (
      <a href={withBase(`/${lang}/concepts/${w.slug}/`)} class="at-radar-legend-item" data-radar-leg={idx}>
        <span
          style={`width:10px;height:3px;border-radius:2px;background:${w.color};display:inline-block;`}
        />
        <span>{w[lang]}</span>
        <strong class="at-mono" data-radar-val={idx} style="font-size:0.72rem;color:var(--ink-primary);">
          {w.latest}
        </strong>
      </a>
    ))}
  </div>

  <div style="position:relative;">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      width="100%"
      style="display:block;height:auto;cursor:crosshair;background:var(--bg-canvas);border:1px solid var(--border-subtle);border-radius:4px;"
      role="img"
      aria-label="Four-Wave AI Practice Chart"
      data-radar-svg
    >
      {[0.25, 0.5, 0.75].map((r) => (
        <line
          x1={PAD}
          y1={+(PAD + (H - PAD * 2) * r).toFixed(1)}
          x2={W - PAD}
          y2={+(PAD + (H - PAD * 2) * r).toFixed(1)}
          stroke="var(--border-subtle)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
      ))}

      <!-- Highlight area under the 2026 Context & Skills frontier curve -->
      <path d={waves[3].geom.areaPath} fill="var(--accent-signal-soft)" />

      {waves.map((w) => (
        <path
          d={w.geom.path}
          fill="none"
          stroke={w.color}
          stroke-width={w.slug === "context-engineering" ? "2.8" : "2.1"}
          stroke-dasharray={w.dashed ? "4 3" : undefined}
          stroke-linecap="round"
        />
      ))}

      <!-- Interactive vertical scrub crosshair -->
      <line
        data-radar-cursor
        x1={xCoords[xCoords.length - 1]}
        y1={PAD - 4}
        x2={xCoords[xCoords.length - 1]}
        y2={H - PAD + 4}
        stroke="var(--ink-muted)"
        stroke-width="1"
        stroke-dasharray="2 2"
      />

      {waves.map((w, idx) => {
        const lastPt = w.geom.points[w.geom.points.length - 1];
        return (
          <circle
            data-radar-dot={idx}
            cx={lastPt.x}
            cy={lastPt.y}
            r={idx === 3 ? "4.6" : "3.5"}
            fill={w.color}
            stroke="var(--bg-canvas)"
            stroke-width="1.5"
          />
        );
      })}
    </svg>

    <div class="at-mono" style="display:flex;justify-content:space-between;font-size:0.66rem;color:var(--ink-muted);margin-top:4px;padding:0 4px;">
      <span>22H2</span>
      <span>23H2</span>
      <span>24H2</span>
      <span>25H2</span>
      <span style="color:var(--accent-signal);font-weight:600;">26Q3</span>
    </div>
  </div>

  <!-- 4-Cell Precision Telemetry Strip -->
  <div class="at-telemetry-strip">
    <div class="at-telemetry-cell">
      <div class="at-telemetry-num">{ERAS.length}→{CONCEPTS.length}</div>
      <div class="at-telemetry-lbl">{lang === "zh" ? "阶段与核心词" : "Stages & Topics"}</div>
    </div>
    <div class="at-telemetry-cell" style="border-left-color:var(--accent-signal);">
      <div class="at-telemetry-num">{NODES.length}</div>
      <div class="at-telemetry-lbl">{lang === "zh" ? "挑好的精华片段" : "Video Highlights"}</div>
    </div>
    <div class="at-telemetry-cell">
      <div class="at-telemetry-num">{SPINE_NODES.length}</div>
      <div class="at-telemetry-lbl">{lang === "zh" ? "口碑必看代表作" : "Essential Picks"}</div>
    </div>
    <div class="at-telemetry-cell" style="border-left-color:var(--accent-evergreen);">
      <div class="at-telemetry-num">~{totalHours}h</div>
      <div class="at-telemetry-lbl">{lang === "zh" ? "替你省掉废话" : "Fluff Skipped"}</div>
    </div>
  </div>

  <script
    type="application/json"
    data-radar-payload
    set:html={JSON.stringify({
      labels: SERIES_LABELS,
      xs: xCoords,
      pts: waves.map((w) => w.geom.points),
    })}
  />
  <script is:inline>
    (() => {
      const root = document.querySelector("[data-wave-radar]");
      if (!root) return;
      const svg = root.querySelector("[data-radar-svg]");
      const payloadEl = root.querySelector("[data-radar-payload]");
      if (!svg || !payloadEl) return;
      const data = JSON.parse(payloadEl.textContent || "{}");
      const cursor = root.querySelector("[data-radar-cursor]");
      const qLabel = root.querySelector("[data-radar-quarter]");
      const liveSuffix = qLabel?.getAttribute("data-live-suffix") || "NOW";
      const dots = [...root.querySelectorAll("[data-radar-dot]")];
      const vals = [...root.querySelectorAll("[data-radar-val]")];

      function setIdx(i) {
        const idx = Math.max(0, Math.min(data.labels.length - 1, i));
        const x = data.xs[idx];
        if (cursor) {
          cursor.setAttribute("x1", String(x));
          cursor.setAttribute("x2", String(x));
        }
        if (qLabel) {
          qLabel.textContent = idx === data.labels.length - 1 ? `${data.labels[idx]} · ${liveSuffix}` : data.labels[idx];
        }
        dots.forEach((d, wIdx) => {
          const pt = data.pts[wIdx][idx];
          d.setAttribute("cx", String(pt.x));
          d.setAttribute("cy", String(pt.y));
        });
        vals.forEach((v, wIdx) => {
          v.textContent = String(data.pts[wIdx][idx].val);
        });
      }

      svg.addEventListener("mousemove", (e) => {
        const rect = svg.getBoundingClientRect();
        const ratio = (e.clientX - rect.left) / Math.max(1, rect.width);
        const idx = Math.round(ratio * (data.labels.length - 1));
        setIdx(idx);
      });
      svg.addEventListener("mouseleave", () => setIdx(data.labels.length - 1));
      svg.addEventListener(
        "touchmove",
        (e) => {
          const touch = e.touches[0];
          if (!touch) return;
          const rect = svg.getBoundingClientRect();
          const ratio = (touch.clientX - rect.left) / Math.max(1, rect.width);
          setIdx(Math.round(ratio * (data.labels.length - 1)));
        },
        { passive: true }
      );
    })();
  </script>
</div>
