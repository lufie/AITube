---
import type { MediaNode } from "../lib/content";
import { formatSliceMinutes, formatTime, type Lang } from "../lib/i18n";

interface Props {
  node: MediaNode;
  lang: Lang;
}
const { node, lang } = Astro.props;
const s = node.source;
const isVideo = s.kind === "video-cut" && (s.totalDurationSec || 0) > 0;
const total = Math.max(1, s.totalDurationSec || 100);
const start = s.startSec || 0;
const end = s.endSec || total;
const leftPct = Math.min(92, Math.max(0, (start / total) * 100));
const widthPct = Math.min(100 - leftPct, Math.max(6, ((end - start) / total) * 100));
---
{isVideo && (
  <div class="at-slim-range">
    <span class="at-mono">
      {lang === "zh" ? "精华区间" : "Selected range"} {formatTime(start)}–{formatTime(end)} ({formatSliceMinutes(start, end, lang)})
    </span>
    <div class="at-slim-track" aria-hidden="true">
      <div class="at-slim-fill" style={`left:${leftPct.toFixed(1)}%;width:${widthPct.toFixed(1)}%;`} />
    </div>
    <span class="at-mono">
      {lang === "zh" ? "全片" : "Total"} {formatTime(total)}
    </span>
  </div>
)}

<script is:inline>
  (() => {
    if (window.__aitubeSeekDelegated) return;
    window.__aitubeSeekDelegated = true;
    document.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-seek-sec]");
      if (!btn) return;
      const sec = Number(btn.getAttribute("data-seek-sec") || 0);
      document.querySelectorAll("[data-seek-sec]").forEach((b) => {
        b.classList.toggle("is-active", Number(b.getAttribute("data-seek-sec")) === sec);
      });
      const stageEl = document.getElementById("stage");
      if (stageEl) {
        const rect = stageEl.getBoundingClientRect();
        if (rect.top < -40 || rect.top > window.innerHeight * 0.55) {
          stageEl.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
      if (typeof window.__seekAITubeStage === "function") {
        window.__seekAITubeStage(sec);
      }
    });
  })();
</script>
