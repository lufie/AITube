---
import type { MediaNode } from "../lib/content";
import { formatSliceMinutes, formatTime, type Lang } from "../lib/i18n";

interface Props {
  node: MediaNode;
  lang: Lang;
}
const { node, lang } = Astro.props;
const s = node.source;
const isVideo = s.kind === "video-cut" && (s.totalDurationSec || 0) > 0;
const total = Math.max(1, s.totalDurationSec || 100);
const start = s.startSec || 0;
const end = s.endSec || total;
const leftPct = Math.min(92, Math.max(0, (start / total) * 100));
const widthPct = Math.min(100 - leftPct, Math.max(7, ((end - start) / total) * 100));

const stepTimes = [
  start,
  Math.round(start + (end - start) * 0.36),
  Math.round(start + (end - start) * 0.72),
];
---
{isVideo && (
  <div class="at-scrubber">
    <div class="at-mono" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;font-size:0.75rem;color:var(--ink-secondary);">
      <span>
        {lang === "zh" ? "已为你截取精华片段" : "Best Part Selected"}:{" "}
        <strong style="color:var(--ink-primary);">{formatTime(start)}–{formatTime(end)}</strong>{" "}
        <span style="color:var(--accent-primary);">({formatSliceMinutes(start, end, lang)})</span>
      </span>
      <span>
        {lang === "zh" ? "原视频总长" : "Full Video"}: {formatTime(total)}
      </span>
    </div>

    <div class="at-film-row">
      <span class="at-mono" style="font-size:0.68rem;color:var(--ink-muted);">0:00</span>
      <div class="at-scrubber-track" aria-hidden="true">
        <div class="at-scrubber-slice" style={`left:${leftPct.toFixed(1)}%;width:${widthPct.toFixed(1)}%;`}>
          {widthPct >= 14 ? `${formatTime(start)}–${formatTime(end)}` : ""}
        </div>
      </div>
      <span class="at-mono" style="font-size:0.68rem;color:var(--ink-muted);">{formatTime(total)}</span>
      <span class="at-saved-callout">
        ⚡ {lang === "zh" ? `省 ${s.hoursSaved} 小时` : `Saved ${s.hoursSaved}h`}
      </span>
    </div>

    {s.platform === "youtube" && (
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
        {node[lang].steps.map((st, idx) => (
          <button
            type="button"
            class={`at-chip at-mono ${idx === 0 ? "is-active" : ""}`}
            data-seek-sec={stepTimes[idx]}
            style="font-size:0.74rem;padding:4px 10px;"
          >
            ▶ {formatTime(stepTimes[idx])} · 0{idx + 1} {st.title.slice(0, 22)}
          </button>
        ))}
      </div>
    )}
  </div>
)}

<script is:inline>
  (() => {
    if (window.__aitubeSeekDelegated) return;
    window.__aitubeSeekDelegated = true;
    document.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-seek-sec]");
      if (!btn) return;
      const sec = Number(btn.getAttribute("data-seek-sec") || 0);
      document.querySelectorAll("[data-seek-sec]").forEach((b) => {
        b.classList.toggle("is-active", Number(b.getAttribute("data-seek-sec")) === sec);
      });
      const stageEl = document.getElementById("stage");
      if (stageEl) {
        const rect = stageEl.getBoundingClientRect();
        if (rect.top < -40 || rect.top > window.innerHeight * 0.55) {
          stageEl.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
      if (typeof window.__seekAITubeStage === "function") {
        window.__seekAITubeStage(sec);
      }
    });
  })();
</script>
