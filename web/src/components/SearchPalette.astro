---
import { UI, withBase, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const corpusUrl = withBase(`/search-corpus-${lang}.json`);
const quickTerms =
  lang === "zh"
    ? [
        { label: "怎么喂资料不瞎编", q: "NotebookLM" },
        { label: "MCP 是什么", q: "MCP" },
        { label: "SKILL.md 技能包", q: "SKILL.md" },
        { label: "慢思考推理模型", q: "慢思考" },
        { label: "视频主角不换脸", q: "ComfyUI" },
      ]
    : [
        { label: "Private docs Q&A", q: "NotebookLM" },
        { label: "What is MCP?", q: "MCP" },
        { label: "SKILL.md Manuals", q: "SKILL.md" },
        { label: "Reasoning Models", q: "RLVR" },
        { label: "Consistent AI Video", q: "ComfyUI" },
      ];
---
<dialog class="at-dialog" id="at-search-dialog" data-lang={lang} data-corpus-url={corpusUrl}>
  <div style="padding:16px 18px;border-bottom:1px solid var(--border-subtle);display:flex;gap:10px;align-items:center;">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7.5" />
      <path d="m20 20-3.8-3.8" />
    </svg>
    <input
      type="search"
      id="at-search-input"
      placeholder={t.searchPlaceholder}
      autocomplete="off"
      style="flex:1;border:0;background:transparent;outline:none;font-size:0.98rem;"
    />
    <button type="button" class="at-icon-btn" data-close-search style="height:26px;padding:0 10px;font-size:0.74rem;">ESC</button>
  </div>

  <div style="padding:10px 18px;border-bottom:1px solid var(--border-subtle);display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
    {quickTerms.map((qt) => (
      <button type="button" class="at-chip" data-quick-term={qt.q} style="font-size:0.75rem;padding:4px 10px;">
        {qt.label}
      </button>
    ))}
  </div>

  <div
    id="at-search-results"
    style="max-height:56vh;overflow-y:auto;padding:10px 12px;display:flex;flex-direction:column;gap:2px;"
  >
    <p style="padding:10px 6px;font-size:0.84rem;color:var(--ink-muted);">
      {lang === "zh"
        ? "输入你想解决的问题或任何 AI 概念名称。"
        : "Type any plain-English question or AI topic."}
    </p>
  </div>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById("at-search-dialog");
    const input = document.getElementById("at-search-input");
    const box = document.getElementById("at-search-results");
    if (!dialog || !input || !box) return;
    const lang = dialog.getAttribute("data-lang") || "zh";
    const corpusUrl = dialog.getAttribute("data-corpus-url") || `/search-corpus-${lang}.json`;
    let corpus = null;
    let activeIdx = 0;

    async function ensureCorpus() {
      if (corpus) return corpus;
      try {
        const res = await fetch(corpusUrl);
        corpus = await res.json();
      } catch {
        corpus = [];
      }
      return corpus;
    }

    function syncSelected() {
      const items = [...box.querySelectorAll(".at-search-hit")];
      items.forEach((el, idx) => {
        const sel = idx === activeIdx;
        el.classList.toggle("is-selected", sel);
        if (sel) el.scrollIntoView({ block: "nearest" });
      });
    }

    function renderHits(q) {
      if (!corpus) return;
      const term = q.trim().toLowerCase();
      const cjkBigrams = [];
      const cjkClean = term.replace(/[^\u4e00-\u9fff]/g, "");
      for (let i = 0; i + 1 < cjkClean.length; i++) {
        cjkBigrams.push(cjkClean.slice(i, i + 2));
      }
      const hits = !term
        ? corpus.slice(0, 10)
        : corpus
            .map((it) => {
              const hay = `${it.title} ${it.sub} ${it.tags}`.toLowerCase();
              let score = 0;
              if (it.title.toLowerCase().includes(term)) score += 6;
              if (hay.includes(term)) score += 3;
              for (const tok of term.split(/\s+/)) {
                if (tok && hay.includes(tok)) score += 1;
              }
              for (const bg of cjkBigrams) {
                if (hay.includes(bg)) score += 0.6;
              }
              return { it, score };
            })
            .filter((x) => x.score > 0)
            .sort((a, b) => b.score - a.score)
            .slice(0, 12)
            .map((x) => x.it);

      if (!hits.length) {
        box.innerHTML = `<p style="padding:12px 6px;font-size:0.84rem;color:var(--ink-muted);">${
          lang === "zh" ? "没有找到匹配结果，试试换个日常词。" : "No matches found — try simpler words."
        }</p>`;
        return;
      }
      activeIdx = 0;
      box.innerHTML = hits
        .map(
          (h, idx) => `
          <a href="${h.href}" class="at-search-hit ${idx === 0 ? "is-selected" : ""}">
            <div style="min-width:0;">
              <div style="font-weight:580;font-size:0.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${h.title}</div>
              <div style="font-size:0.78rem;color:var(--ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${h.sub}</div>
            </div>
            <span style="font-size:0.74rem;color:var(--accent-primary);white-space:nowrap;font-weight:550;">${h.badge}</span>
          </a>`
        )
        .join("");
    }

    let closingTimer = 0;

    function closeModal() {
      if (!dialog.open || dialog.classList.contains("is-closing")) return;
      dialog.classList.add("is-closing");
      clearTimeout(closingTimer);
      closingTimer = setTimeout(() => {
        dialog.classList.remove("is-closing");
        if (dialog.open) dialog.close();
      }, 165);
    }

    async function openModal(prefill) {
      clearTimeout(closingTimer);
      dialog.classList.remove("is-closing");
      if (!dialog.open) dialog.showModal();
      await ensureCorpus();
      if (typeof prefill === "string") {
        input.value = prefill;
      }
      input.focus();
      renderHits(input.value);
    }

    document.querySelectorAll("[data-open-search]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const q = btn.getAttribute("data-search-q");
        openModal(q !== null ? q : undefined);
      })
    );
    document.querySelectorAll("[data-quick-term]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const q = btn.getAttribute("data-quick-term") || "";
        input.value = q;
        renderHits(q);
        input.focus();
      })
    );
    document.querySelectorAll("[data-close-search]").forEach((btn) =>
      btn.addEventListener("click", closeModal)
    );
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeModal();
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeModal();
    });
    input.addEventListener("input", () => renderHits(input.value));
    input.addEventListener("keydown", (e) => {
      const items = [...box.querySelectorAll(".at-search-hit")];
      if (!items.length) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIdx = (activeIdx + 1) % items.length;
        syncSelected();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIdx = (activeIdx - 1 + items.length) % items.length;
        syncSelected();
      } else if (e.key === "Enter") {
        const target = items[activeIdx];
        if (target) {
          e.preventDefault();
          window.location.href = target.getAttribute("href");
        }
      }
    });
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (dialog.open) closeModal();
        else openModal();
      }
    });
  })();
</script>
