---
import { UI, withBase, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const corpusUrl = withBase(`/search-corpus-${lang}.json`);
const quickTerms =
  lang === "zh"
    ? [
        { label: "怎么喂资料不瞎编", q: "NotebookLM" },
        { label: "MCP 万能插头", q: "MCP" },
        { label: "SKILL.md 技能包", q: "SKILL.md" },
        { label: "慢思考推理模型", q: "慢思考" },
        { label: "做视频主角不换脸", q: "ComfyUI" },
      ]
    : [
        { label: "Private docs Q&A", q: "NotebookLM" },
        { label: "What is MCP?", q: "MCP" },
        { label: "SKILL.md Manuals", q: "SKILL.md" },
        { label: "Reasoning Models", q: "RLVR" },
        { label: "Consistent AI Video", q: "ComfyUI" },
      ];
---
<dialog class="at-dialog" id="at-search-dialog" data-lang={lang} data-corpus-url={corpusUrl}>
  <div style="padding:14px 16px;border-bottom:1px solid var(--border-subtle);display:flex;gap:10px;align-items:center;">
    <span class="at-mono" style="color:var(--accent-primary);">⌕</span>
    <input
      type="search"
      id="at-search-input"
      placeholder={t.searchPlaceholder}
      autocomplete="off"
      style="flex:1;border:0;background:transparent;outline:none;font-size:0.96rem;"
    />
    <span class="at-kbd">↑↓ ↵</span>
    <button type="button" class="at-icon-btn at-mono" data-close-search style="height:28px;padding:0 8px;">ESC</button>
  </div>

  <div style="padding:8px 16px;border-bottom:1px solid var(--border-subtle);display:flex;flex-wrap:wrap;gap:6px;align-items:center;background:var(--bg-elevated);">
    <span class="at-mono" style="font-size:0.68rem;color:var(--ink-muted);">
      {lang === "zh" ? "大家常问：" : "TRY ASKING:"}
    </span>
    {quickTerms.map((qt) => (
      <button type="button" class="at-prompt-chip" data-quick-term={qt.q} style="font-size:0.72rem;padding:2px 8px;">
        {qt.label}
      </button>
    ))}
  </div>

  <div
    id="at-search-results"
    style="max-height:58vh;overflow-y:auto;padding:12px 16px;display:flex;flex-direction:column;gap:8px;"
  >
    <p style="font-size:0.84rem;color:var(--ink-muted);">
      {lang === "zh"
        ? "直接用大白话搜就行，比如「AI 怎么思考」「喂资料」「写代码」「MCP」「不换脸」。"
        : "Type any question in plain English — e.g. how LLMs talk, private docs Q&A, MCP, SKILL.md, or ComfyUI."}
    </p>
  </div>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.getElementById("at-search-dialog");
    const input = document.getElementById("at-search-input");
    const box = document.getElementById("at-search-results");
    if (!dialog || !input || !box) return;
    const lang = dialog.getAttribute("data-lang") || "zh";
    const corpusUrl = dialog.getAttribute("data-corpus-url") || `/search-corpus-${lang}.json`;
    let corpus = null;
    let activeIdx = 0;

    async function ensureCorpus() {
      if (corpus) return corpus;
      try {
        const res = await fetch(corpusUrl);
        corpus = await res.json();
      } catch {
        corpus = [];
      }
      return corpus;
    }

    function syncSelected() {
      const items = [...box.querySelectorAll(".at-search-hit")];
      items.forEach((el, idx) => {
        const sel = idx === activeIdx;
        el.classList.toggle("is-selected", sel);
        if (sel) el.scrollIntoView({ block: "nearest" });
      });
    }

    function renderHits(q) {
      if (!corpus) return;
      const term = q.trim().toLowerCase();
      const cjkBigrams = [];
      const cjkClean = term.replace(/[^\u4e00-\u9fff]/g, "");
      for (let i = 0; i + 1 < cjkClean.length; i++) {
        cjkBigrams.push(cjkClean.slice(i, i + 2));
      }
      const hits = !term
        ? corpus.slice(0, 10)
        : corpus
            .map((it) => {
              const hay = `${it.title} ${it.sub} ${it.tags}`.toLowerCase();
              let score = 0;
              if (it.title.toLowerCase().includes(term)) score += 6;
              if (hay.includes(term)) score += 3;
              for (const tok of term.split(/\s+/)) {
                if (tok && hay.includes(tok)) score += 1;
              }
              for (const bg of cjkBigrams) {
                if (hay.includes(bg)) score += 0.6;
              }
              return { it, score };
            })
            .filter((x) => x.score > 0)
            .sort((a, b) => b.score - a.score)
            .slice(0, 14)
            .map((x) => x.it);

      activeIdx = 0;
      if (!hits.length) {
        box.innerHTML = `<p style="font-size:0.85rem;color:var(--ink-muted);">${
          lang === "zh" ? "没搜到完全一致的词，换个日常词试试？比如搜「喂资料」「写代码」「MCP」或「画图」。" : "No exact matches yet — try broader words like MCP, docs, coding, or video."
        }</p>`;
        return;
      }

      box.innerHTML = hits
        .map(
          (h, idx) => `
          <a href="${h.href}" class="at-search-hit ${idx === 0 ? "is-selected" : ""}">
            <div style="min-width:0;">
              <div style="font-size:0.71rem;font-family:var(--font-mono);color:var(--accent-primary);">${h.badge}</div>
              <div style="font-weight:580;font-size:0.93rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${h.title}</div>
              <div style="font-size:0.8rem;color:var(--ink-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${h.sub}</div>
            </div>
            <span class="at-mono" style="font-size:0.78rem;color:var(--ink-muted);">↵</span>
          </a>`
        )
        .join("");
    }

    async function openModal(prefill = "") {
      dialog.showModal();
      await ensureCorpus();
      if (typeof prefill === "string" && prefill) input.value = prefill;
      renderHits(input.value);
      input.focus();
    }

    document.querySelectorAll("[data-open-search]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const q = btn.getAttribute("data-search-q") || "";
        openModal(q);
      });
    });
    dialog.querySelectorAll("[data-quick-term]").forEach((btn) => {
      btn.addEventListener("click", () => {
        input.value = btn.getAttribute("data-quick-term") || "";
        renderHits(input.value);
        input.focus();
      });
    });
    document.querySelectorAll("[data-close-search]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        openModal();
      }
    });
    input.addEventListener("keydown", (e) => {
      const items = [...box.querySelectorAll(".at-search-hit")];
      if (!items.length) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIdx = (activeIdx + 1) % items.length;
        syncSelected();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIdx = (activeIdx - 1 + items.length) % items.length;
        syncSelected();
      } else if (e.key === "Enter" && items[activeIdx]) {
        e.preventDefault();
        window.location.href = items[activeIdx].getAttribute("href");
      }
    });
    input.addEventListener("input", () => renderHits(input.value));
    window.__openAITubeSearch = openModal;
  })();
</script>
