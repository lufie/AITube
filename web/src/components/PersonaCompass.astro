---
import MediaCard from "./MediaCard.astro";
import { NODES } from "../lib/content";
import { withBase, type Lang } from "../lib/i18n";
import { PERSONAS } from "../lib/personas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const nodeBySlug = new Map(NODES.map((n) => [n.slug, n]));

const shortTabLabel: Record<string, { zh: string; en: string }> = {
  beginner: { zh: "零基础入门", en: "Beginners" },
  applied: { zh: "日常工作提效", en: "Everyday Work" },
  career: { zh: "系统转行开发", en: "AI Engineering" },
  frontier: { zh: "2026 最新趋势", en: "2026 Trends" },
};
const startersByRole = Object.fromEntries(
  PERSONAS.map((p) => [
    p.id,
    p.picks
      .map((st) => nodeBySlug.get(st.slug))
      .filter((n): n is NonNullable<typeof n> => Boolean(n)),
  ])
);
---
<div class="at-compass" id="persona-compass">
  <div class="at-compass-bar">
    <div class="at-segmented" data-liquid-seg role="tablist" aria-label={lang === "zh" ? "选择学习方向" : "Choose your track"}>
      {PERSONAS.map((p, idx) => {
        const isDefault = idx === 0;
        const tabText = shortTabLabel[p.id]?.[lang] || p[lang].shortLabel;
        return (
          <button
            type="button"
            role="tab"
            aria-selected={isDefault ? "true" : "false"}
            class={`at-seg-btn ${isDefault ? "is-active" : ""}`}
            data-role-tab={p.id}
          >
            {tabText}
          </button>
        );
      })}
    </div>
  </div>

  {PERSONAS.map((p, idx) => {
    const loc = p[lang];
    const isDefault = idx === 0;
    const starterNodes = startersByRole[p.id] || [];

    return (
      <div
        role="tabpanel"
        class="at-track-panel"
        data-role-panel={p.id}
        style={isDefault ? "" : "display:none;"}
      >
        <div class="at-track-summary">
          <p class="at-track-headline">
            <strong>{loc.headline}</strong>
          </p>
          <a href={withBase(p.primaryHref(lang))} class="at-text-link">
            {loc.primaryCta.replace(/\s*→$/, "")} ›
          </a>
        </div>

        <div class="at-grid-cards">
          {starterNodes.map((node, cIdx) => (
            <div class="at-cascade-item" style={`--card-i:${cIdx};`}>
              <MediaCard node={node} lang={lang} eager={isDefault} />
            </div>
          ))}
        </div>
      </div>
    );
  })}
</div>

<script is:inline>
  (() => {
    const root = document.getElementById("persona-compass");
    if (!root) return;
    const tabs = [...root.querySelectorAll("[data-role-tab]")];
    const panels = [...root.querySelectorAll("[data-role-panel]")];
    const valid = new Set(tabs.map((t) => t.getAttribute("data-role-tab")));

    function activateRole(roleId, pushUrl, animate) {
      if (!valid.has(roleId)) return;
      tabs.forEach((btn) => {
        const active = btn.getAttribute("data-role-tab") === roleId;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute("data-role-panel") === roleId;
        if (active) {
          panel.style.display = "";
          if (animate) {
            panel.classList.remove("is-entering");
            void panel.offsetWidth;
            panel.classList.add("is-entering");
          }
        } else {
          panel.style.display = "none";
          panel.classList.remove("is-entering");
        }
      });
      if (window.__syncLiquidSegs) window.__syncLiquidSegs();
      try {
        localStorage.setItem("aitube-role", roleId);
        if (pushUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set("role", roleId);
          window.history.replaceState({}, "", url.toString());
        }
      } catch {}
    }

    try {
      const sp = new URLSearchParams(window.location.search);
      const qRole = sp.get("role");
      const saved = localStorage.getItem("aitube-role");
      if (qRole && valid.has(qRole)) activateRole(qRole, false, false);
      else if (saved && valid.has(saved)) activateRole(saved, false, false);
    } catch {}

    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const roleId = btn.getAttribute("data-role-tab");
        if (roleId) activateRole(roleId, true, true);
      });
    });
  })();
</script>
