---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  class="at-logo-mark"
  style="flex-shrink:0;"
>
  <defs>
    <linearGradient id="at-lg-squircle" x1="8" y1="4" x2="56" y2="60" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#3a8dff" />
      <stop offset="52%" stop-color="#0066cc" />
      <stop offset="100%" stop-color="#004999" />
    </linearGradient>
    <linearGradient id="at-lg-rim" x1="8" y1="4" x2="52" y2="58" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.78" />
      <stop offset="50%" stop-color="#ffffff" stop-opacity="0.18" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.38" />
    </linearGradient>
  </defs>
  <rect x="3" y="3" width="58" height="58" rx="17" fill="url(#at-lg-squircle)" />
  <path d="M12 10C20 6 44 6 52 10C46 18 18 18 12 10Z" fill="#ffffff" fill-opacity="0.24" />
  <rect x="3.75" y="3.75" width="56.5" height="56.5" rx="16.25" stroke="url(#at-lg-rim)" stroke-width="1.5" />
  <polygon points="25.5 19.5 46.5 32 25.5 44.5 25.5 19.5" fill="#ffffff" />
</svg>
