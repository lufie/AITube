---
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  style="flex-shrink:0;"
>
  <rect x="2" y="2" width="60" height="60" rx="16" fill="var(--ink-primary)" />
  <polygon points="25 19 46 32 25 45 25 19" fill="var(--bg-canvas)" />
</svg>
