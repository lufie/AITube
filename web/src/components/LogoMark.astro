---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  style="flex-shrink:0;"
>
  <rect x="2" y="2" width="60" height="60" rx="12" fill="var(--bg-elevated)" stroke="var(--ink-primary)" stroke-width="2.5" />
  <path d="M18 49L32 14L46 49" stroke="var(--ink-primary)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M13 38C21 38 25 27 33 27C40 27 44 33 51 22" stroke="var(--accent-primary)" stroke-width="4.2" stroke-linecap="round" />
  <circle cx="46" cy="25" r="4.8" fill="var(--accent-signal)" />
</svg>
