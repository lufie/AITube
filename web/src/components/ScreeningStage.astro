---
import type { MediaNode } from "../lib/content";
import { UI, formatTime, type Lang } from "../lib/i18n";

interface Props {
  node: MediaNode;
  lang: Lang;
}
const { node, lang } = Astro.props;
const loc = node[lang];
const s = node.source;
const t = UI[lang];
const ytThumb = s.platform === "youtube" && s.videoId ? `https://i.ytimg.com/vi/${s.videoId}/maxresdefault.jpg` : null;
const ytFallback = s.platform === "youtube" && s.videoId ? `https://i.ytimg.com/vi/${s.videoId}/hqdefault.jpg` : null;
---
<div class="at-stage-bezel">
  <div
    class="at-stage-frame"
    id="at-screening-stage"
    data-kind={s.kind}
    data-platform={s.platform}
    data-video-id={s.videoId || ""}
    data-start={s.startSec || 0}
    data-end={s.endSec || 0}
  >
    {s.kind === "video-cut" && s.platform === "youtube" && s.videoId ? (
      <div
        id="at-stage-poster"
        class="at-stage-poster-inner"
        role="button"
        tabindex="0"
        aria-label={t.watchSlice}
      >
        <img
          src={ytThumb || ""}
          data-fallback={ytFallback || ""}
          alt={loc.title}
          class="at-stage-poster-img"
          onerror="if(this.dataset.fallback && this.src!==this.dataset.fallback){this.src=this.dataset.fallback;}else{this.remove();}"
        />
        <div class="at-stage-vignette" aria-hidden="true"></div>

        <div style="position:relative;z-index:2;text-align:center;">
          <div class="at-liquid-play-pill">
            <span class="at-liquid-play-dot" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="8 5 19 12 8 19 8 5" />
              </svg>
            </span>
            <span>
              {t.watchSlice} · {formatTime(s.startSec || 0)}–{formatTime(s.endSec || 0)}
            </span>
          </div>
        </div>
      </div>
    ) : s.kind === "video-cut" && s.platform === "bilibili" && s.videoId ? (
      <div style="position:absolute;inset:0;padding:32px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:radial-gradient(circle at 30% 20%, #243346 0%, #0d1117 80%);">
        <p style="font-size:0.84rem;color:rgba(245,245,247,0.68);margin-bottom:8px;">
          Bilibili · {s.channelName}
        </p>
        <p style="font-size:1.25rem;font-weight:600;max-width:48ch;margin-bottom:20px;">{s.originalTitle}</p>
        <a
          href={`https://www.bilibili.com/video/${s.videoId}/?t=${s.startSec || 0}`}
          target="_blank"
          rel="noopener noreferrer"
          class="at-liquid-play-pill"
        >
          <span>▶ {lang === "zh" ? `在 B 站从 ${formatTime(s.startSec || 0)} 播放 ↗` : `Watch on Bilibili at ${formatTime(s.startSec || 0)} ↗`}</span>
        </a>
      </div>
    ) : (
      <div style="position:absolute;inset:0;padding:32px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:radial-gradient(circle at 30% 20%, #243346 0%, #0d1117 80%);">
        <p style="font-size:0.84rem;color:rgba(245,245,247,0.68);margin-bottom:8px;">
          {s.channelName} · {lang === "zh" ? `约 ${s.readingMinutes || 12} 分钟阅读` : `${s.readingMinutes || 12} min read`}
        </p>
        <p style="font-size:1.3rem;font-weight:600;max-width:48ch;margin-bottom:20px;">{s.originalTitle}</p>
        <a
          href={s.articleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="at-liquid-play-pill"
        >
          <span>{t.readDigest} ↗</span>
        </a>
      </div>
    )}
  </div>
</div>

<script is:inline>
  (() => {
    const stage = document.getElementById("at-screening-stage");
    const poster = document.getElementById("at-stage-poster");
    if (!stage) return;

    function mountYoutube(seekSec) {
      const vid = stage.getAttribute("data-video-id");
      if (!vid) return;
      const start = typeof seekSec === "number" ? seekSec : Number(stage.getAttribute("data-start") || 0);
      const end = Number(stage.getAttribute("data-end") || 0);
      const params = new URLSearchParams({
        autoplay: "1",
        rel: "0",
        modestbranding: "1",
        start: String(Math.max(0, Math.floor(start))),
      });
      if (end > start) params.set("end", String(Math.floor(end)));
      stage.innerHTML = "";
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${vid}?${params.toString()}`;
      iframe.title = "YouTube video player";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      stage.appendChild(iframe);
    }

    if (poster) {
      poster.addEventListener("click", () => mountYoutube());
      poster.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          mountYoutube();
        }
      });
    }
    window.__seekAITubeStage = mountYoutube;
  })();
</script>
