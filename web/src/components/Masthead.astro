---
import LogoMark from "./LogoMark.astro";
import { UI, otherLang, stripBase, switchLangPath, withBase, type Lang } from "../lib/i18n";
import { NODES } from "../lib/content";

interface Props {
  lang: Lang;
  pathname: string;
}
const { lang, pathname } = Astro.props;
const t = UI[lang];
const altLang = otherLang(lang);
const altHref = switchLangPath(pathname, altLang);
const cleanPath = stripBase(pathname);

const navItems = [
  { href: withBase(`/${lang}/`), label: lang === "zh" ? "首页导览" : "Start Here", exact: `/${lang}/` },
  { href: withBase(`/${lang}/roadmap/`), label: t.navRoadmap, match: `/${lang}/roadmap` },
  { href: withBase(`/${lang}/timeline/`), label: t.navTimeline, match: `/${lang}/timeline` },
  { href: withBase(`/${lang}/directory/`), label: t.navDirectory, match: `/${lang}/directory` },
  { href: withBase(`/${lang}/vault/`), label: t.navVault, match: `/${lang}/vault` },
];
---
<header class="at-masthead">
  <div class="at-container at-masthead-inner">
    <a href={withBase(`/${lang}/`)} class="at-brand" aria-label={t.siteName}>
      <LogoMark size={28} />
      <span>AITube</span>
    </a>

    <nav class="at-nav" aria-label="Primary">
      {navItems.map((it) => {
        const isCurrent = it.exact ? cleanPath === it.exact : it.match ? cleanPath.startsWith(it.match) : false;
        return (
          <a
            href={it.href}
            class={`at-nav-link ${it.exact ? "at-nav-home-link" : ""}`}
            aria-current={isCurrent ? "page" : undefined}
          >
            {it.label}
          </a>
        );
      })}
    </nav>

    <div class="at-actions">
      <button type="button" class="at-search-trigger" data-open-search aria-label={t.searchBtn}>
        <span>⌕ {t.searchBtn}</span>
        <span class="at-kbd">⌘K</span>
      </button>

      <a
        href={withBase(`/${lang}/roadmap/`)}
        class="at-icon-btn at-mono"
        title={t.readProgressTitle}
        data-read-counter
        data-total={NODES.length}
      >
        0/{NODES.length}
      </a>

      <a href={altHref} class="at-icon-btn at-mono" hreflang={altLang === "zh" ? "zh-CN" : "en"}>
        {t.langLabel}
      </a>

      <button type="button" class="at-icon-btn" data-theme-toggle aria-label={t.themeToggle} title={t.themeToggle}>
        ◐
      </button>
    </div>
  </div>
</header>
