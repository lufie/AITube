---
import LogoMark from "./LogoMark.astro";
import { UI, otherLang, stripBase, switchLangPath, withBase, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  pathname: string;
}
const { lang, pathname } = Astro.props;
const t = UI[lang];
const altLang = otherLang(lang);
const altHref = switchLangPath(pathname, altLang);
const cleanPath = stripBase(pathname);

const navItems = [
  { href: withBase(`/${lang}/`), label: t.navHome, exact: `/${lang}/` },
  { href: withBase(`/${lang}/roadmap/`), label: t.navRoadmap, match: `/${lang}/roadmap` },
  { href: withBase(`/${lang}/timeline/`), label: t.navTimeline, match: `/${lang}/timeline` },
  { href: withBase(`/${lang}/directory/`), label: t.navDirectory, match: `/${lang}/directory` },
  { href: withBase(`/${lang}/vault/`), label: t.navVault, match: `/${lang}/vault` },
];
---
<header class="at-masthead">
  <div class="at-container at-masthead-inner">
    <a href={withBase(`/${lang}/`)} class="at-brand" aria-label={t.siteName}>
      <LogoMark size={24} />
      <span>AITube</span>
    </a>

    <nav class="at-nav" aria-label="Primary">
      {navItems.map((it) => {
        const isCurrent = it.exact ? cleanPath === it.exact : it.match ? cleanPath.startsWith(it.match) : false;
        return (
          <a
            href={it.href}
            class={`at-nav-link ${it.exact ? "at-nav-home-link" : ""}`}
            aria-current={isCurrent ? "page" : undefined}
          >
            {it.label}
          </a>
        );
      })}
    </nav>

    <div class="at-actions">
      <button type="button" class="at-search-trigger" data-open-search aria-label={t.searchBtn}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7.5" />
          <path d="m20 20-3.8-3.8" />
        </svg>
        <span>{t.searchBtn}</span>
        <span class="at-kbd">⌘K</span>
      </button>

      <a href={altHref} class="at-icon-btn" hreflang={altLang === "zh" ? "zh-CN" : "en"}>
        {t.langLabel}
      </a>

      <button type="button" class="at-icon-btn" data-theme-toggle aria-label={t.themeToggle} title={t.themeToggle} style="padding:0 9px;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>
    </div>
  </div>
</header>
