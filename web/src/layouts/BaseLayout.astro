---
import "../styles/global.css";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { UI, withBase, type Lang } from "../lib/i18n";
import { absUrl, buildAlternates } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pathname: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  lang,
  pathname,
  ogImage = `/og/home-${lang}.png`,
  schema,
} = Astro.props;

const canonical = absUrl(pathname.endsWith("/") ? pathname : `${pathname}/`);
const alts = buildAlternates(pathname);
const ogAbs = absUrl(ogImage);
const htmlLang = lang === "zh" ? "zh-CN" : "en";
const toastMsg = UI[lang].copyToast;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AITube" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("aitube-theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.setAttribute("data-theme", saved);
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch {}
      })();
    </script>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body data-toast-msg={toastMsg}>
    <!-- Ambient Optical Light Field Behind All Liquid Glass Layers -->
    <div class="at-ambient-canvas" aria-hidden="true">
      <div class="at-ambient-orb at-orb-sky"></div>
      <div class="at-ambient-orb at-orb-warm"></div>
      <div class="at-ambient-orb at-orb-aqua"></div>
    </div>

    <Masthead lang={lang} pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchPalette lang={lang} />
    <div id="at-toast" class="at-toast-glass at-mono" role="status" aria-live="polite"></div>

    <script is:inline>
      (() => {
        try {
          const curLang = document.documentElement.lang.startsWith("en") ? "en" : "zh";
          localStorage.setItem("aitube-lang", curLang);
        } catch {}

        // 1. Scroll-Reactive Floating Liquid Glass Masthead Condensation
        const syncScroll = () => {
          if (window.scrollY > 14) {
            document.documentElement.setAttribute("data-scrolled", "1");
          } else {
            document.documentElement.removeAttribute("data-scrolled");
          }
        };
        syncScroll();
        window.addEventListener("scroll", syncScroll, { passive: true });

        // 2. Spring-Physics Sliding Liquid Glass Nav Droplet
        document.querySelectorAll("[data-liquid-nav]").forEach((nav) => {
          const glider = nav.querySelector(".at-nav-glider");
          const links = [...nav.querySelectorAll(".at-nav-link")];
          if (!glider || !links.length) return;

          const moveNavGlider = (target, instant) => {
            if (!target || target.offsetParent === null) {
              glider.style.opacity = "0";
              return;
            }
            if (instant) glider.style.transition = "none";
            glider.style.opacity = "1";
            glider.style.width = `${target.offsetWidth}px`;
            glider.style.height = `${target.offsetHeight}px`;
            glider.style.transform = `translate3d(${target.offsetLeft}px, ${target.offsetTop}px, 0)`;
            if (instant) {
              void glider.offsetWidth;
              glider.style.transition = "";
            }
          };

          const getActiveLink = () => nav.querySelector('.at-nav-link[aria-current="page"]');
          nav.setAttribute("data-glider-ready", "1");
          moveNavGlider(getActiveLink(), true);

          links.forEach((lk) => {
            lk.addEventListener("mouseenter", () => moveNavGlider(lk, false));
          });
          nav.addEventListener("mouseleave", () => moveNavGlider(getActiveLink(), false));
          window.addEventListener("resize", () => moveNavGlider(getActiveLink(), true), { passive: true });
        });

        // 3. Spring-Physics Sliding Liquid Droplet for All Segmented Controls
        function syncLiquidSegs(instant) {
          document.querySelectorAll("[data-liquid-seg]").forEach((seg) => {
            let glider = seg.querySelector(".at-seg-glider");
            if (!glider) {
              glider = document.createElement("span");
              glider.className = "at-seg-glider";
              glider.setAttribute("aria-hidden", "true");
              seg.prepend(glider);
            }
            const active = seg.querySelector(".at-seg-btn.is-active");
            if (!active || active.offsetParent === null) {
              glider.style.opacity = "0";
              return;
            }
            const firstInit = !seg.hasAttribute("data-glider-ready");
            seg.setAttribute("data-glider-ready", "1");
            const noAnim = instant === true || firstInit;
            if (noAnim) glider.style.transition = "none";
            else {
              glider.setAttribute("data-stretching", "1");
              clearTimeout(glider.__stretchTimer);
              glider.__stretchTimer = setTimeout(() => glider.removeAttribute("data-stretching"), 260);
            }
            glider.style.opacity = "1";
            glider.style.width = `${active.offsetWidth}px`;
            glider.style.height = `${active.offsetHeight}px`;
            glider.style.transform = `translate3d(${active.offsetLeft}px, ${active.offsetTop}px, 0)`;
            if (noAnim) {
              void glider.offsetWidth;
              glider.style.transition = "";
            }
          });
        }
        window.__syncLiquidSegs = syncLiquidSegs;
        syncLiquidSegs(true);
        window.addEventListener("resize", () => syncLiquidSegs(true), { passive: true });

        // 4. Cursor-Tracked Specular Glass Refraction (--mx, --my)
        const glassSelector =
          ".at-era-card, .at-collection-card, .at-concept-card, .at-side-card, .at-vault-card, .at-horizon-shell, .at-card-bezel";
        let rafPending = false;
        let lastEvt = null;
        document.addEventListener(
          "pointermove",
          (e) => {
            if (e.pointerType === "touch") return;
            lastEvt = e;
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(() => {
              rafPending = false;
              if (!lastEvt) return;
              const target = lastEvt.target && lastEvt.target.closest ? lastEvt.target.closest(glassSelector) : null;
              if (!target) return;
              const r = target.getBoundingClientRect();
              target.style.setProperty("--mx", `${Math.round(lastEvt.clientX - r.left)}px`);
              target.style.setProperty("--my", `${Math.round(lastEvt.clientY - r.top)}px`);
            });
          },
          { passive: true }
        );

        // 5. Scroll-Triggered Spatial Reveal for Below-the-Fold Glass Surfaces
        const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!prefersReduced && "IntersectionObserver" in window) {
          const revealTargets = document.querySelectorAll(
            ".at-era-card, .at-collection-card, .at-concept-card, .at-vault-card, .at-roadmap-stage"
          );
          const vh = window.innerHeight || 900;
          const revealObs = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((en) => {
                if (en.isIntersecting) {
                  en.target.classList.add("is-revealed");
                  en.target.classList.remove("at-will-reveal");
                  obs.unobserve(en.target);
                }
              });
            },
            { rootMargin: "0px 0px -6% 0px", threshold: 0.06 }
          );
          revealTargets.forEach((el, i) => {
            const rect = el.getBoundingClientRect();
            if (rect.top > vh * 1.06) {
              el.style.setProperty("--reveal-delay", `${(i % 4) * 55}ms`);
              el.classList.add("at-will-reveal");
              revealObs.observe(el);
            }
          });
        }

        // 6. Read / Watched State Persistence
        const STORAGE_KEY = "aitube-completed-v1";
        function getReadSet() {
          try {
            return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"));
          } catch {
            return new Set();
          }
        }
        function saveReadSet(set) {
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
          } catch {}
        }
        function syncReadUI() {
          const set = getReadSet();
          document.querySelectorAll("[data-read-counter]").forEach((el) => {
            const total = el.getAttribute("data-total") || "280";
            el.textContent = `${set.size}/${total}`;
          });
          document.querySelectorAll("[data-toggle-read]").forEach((btn) => {
            const slug = btn.getAttribute("data-toggle-read");
            const done = slug && set.has(slug);
            btn.textContent = done
              ? btn.getAttribute("data-label-read")
              : btn.getAttribute("data-label-unread");
          });
          document.querySelectorAll("[data-node-slug]").forEach((card) => {
            const slug = card.getAttribute("data-node-slug");
            if (slug && set.has(slug)) card.setAttribute("data-completed", "1");
            else card.removeAttribute("data-completed");
          });
        }
        window.__syncAITubeReadUI = syncReadUI;
        syncReadUI();

        document.querySelectorAll("[data-toggle-read]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const slug = btn.getAttribute("data-toggle-read");
            if (!slug) return;
            const set = getReadSet();
            if (set.has(slug)) set.delete(slug);
            else set.add(slug);
            saveReadSet(set);
            syncReadUI();
          });
        });

        // 7. Interactive 10-Quarter Sparkline Scrubbing
        document.querySelectorAll("[data-spark-box]").forEach((box) => {
          const svg = box.querySelector("[data-spark-svg]");
          const dot = box.querySelector("[data-sp-dot]");
          const guide = box.querySelector("[data-sp-guide]");
          const mid = box.querySelector("[data-sp-mid]");
          if (!svg || !dot || !mid) return;
          let pts = [];
          let labels = [];
          try {
            pts = JSON.parse(box.getAttribute("data-pts") || "[]");
            labels = JSON.parse(box.getAttribute("data-labels") || "[]");
          } catch {}
          if (!pts.length) return;
          const defMom = box.getAttribute("data-default-mom") || "";
          const infIdx = Number(box.getAttribute("data-inflect-idx") || pts.length - 1);

          function showAt(idx) {
            const p = pts[idx];
            if (!p) return;
            dot.setAttribute("cx", String(p.x));
            dot.setAttribute("cy", String(p.y));
            if (guide) {
              guide.setAttribute("x1", String(p.x));
              guide.setAttribute("x2", String(p.x));
              guide.setAttribute("opacity", "0.85");
            }
            mid.textContent = `${labels[idx] || ""}${idx === infIdx ? " ★" : ""} · ${p.val}`;
          }

          function reset() {
            const p = pts[infIdx] || pts[pts.length - 1];
            dot.setAttribute("cx", String(p.x));
            dot.setAttribute("cy", String(p.y));
            if (guide) {
              guide.setAttribute("x1", String(p.x));
              guide.setAttribute("x2", String(p.x));
              guide.setAttribute("opacity", "0.45");
            }
            mid.textContent = defMom;
          }

          svg.addEventListener("mousemove", (e) => {
            const rect = svg.getBoundingClientRect();
            const ratio = (e.clientX - rect.left) / Math.max(1, rect.width);
            const idx = Math.max(0, Math.min(pts.length - 1, Math.round(ratio * (pts.length - 1))));
            showAt(idx);
          });
          svg.addEventListener("mouseleave", reset);
        });

        // 8. Smooth Theme Switch
        document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
          btn.addEventListener("click", () => {
            document.documentElement.classList.add("at-theme-switching");
            const cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
            const next = cur === "dark" ? "light" : "dark";
            document.documentElement.setAttribute("data-theme", next);
            try {
              localStorage.setItem("aitube-theme", next);
            } catch {}
            setTimeout(() => document.documentElement.classList.remove("at-theme-switching"), 380);
          });
        });

        // 9. Liquid Glass Copy Toast
        const toast = document.getElementById("at-toast");
        const msg = document.body.getAttribute("data-toast-msg") || "Copied";
        document.addEventListener("click", (e) => {
          const chip = e.target.closest("[data-copy-op]");
          if (!chip) return;
          const val = chip.getAttribute("data-copy-op") || "";
          navigator.clipboard?.writeText(val).catch(() => {});
          if (toast) {
            const preview = val.replace(/\s+/g, " ").trim();
            toast.textContent = preview.length > 44 ? `${msg}: ${preview.slice(0, 44)}…` : `${msg}: ${preview}`;
            toast.classList.add("is-visible");
            clearTimeout(window.__atToastTimer);
            window.__atToastTimer = setTimeout(() => {
              toast.classList.remove("is-visible");
            }, 1800);
          }
        });
      })();
    </script>
  </body>
</html>
